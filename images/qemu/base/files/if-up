#!/bin/bash

# qemu bridge helper.
#
# qemu invokes this as:  if-up <tap> <bridge>
# where <tap> is the tap device qemu just created (ensN) and <bridge> is the
# value passed to qemu_add_nic (netN). The matching ctlabs container interface
# ethN is moved into the same bridge as the tap, so the guest inherits the
# container NIC's addressing. ethN <-> ensN by index; eth0 is the mgmt NIC.
#
# ctlabs always passes eth0/eth1 through and passes any extra NICs unless they
# are listed in QEMU_CONTAINER_NICS (see lib/node.rb), in which case they are
# never handed to qemu and this helper is not called for them.

tap="${1:-}"
br="${2:-}"

[ -n "${tap}" ] || exit 0

idx="${tap#ens}"
[ "${idx}" != "${tap}" ] || exit 0      # not an ens* tap

nic="eth${idx}"
[ -e "/sys/class/net/${nic}" ] || exit 0

ip=$( ip -br addr ls "${nic}" | awk '{print $3}' )
[ -n "${ip}" ] || continue
echo "${ip}" > /tmp/${nic}.ip

# Record this NIC's own gateway so if-down can restore it. Pin to the NIC: once
# per-NIC gateways exist there are several 'default' routes in the main table,
# and a bare `ip route ls default` would emit one line per route.
if [ "${nic}" == "eth0" ]; then
  gw=$( ip -br route ls default vrf mgmt | awk '{print $3}' | head -n1 )
else
  gw=$( ip -br route ls default dev "${nic}" | awk '{print $3}' | head -n1 )
fi
echo "${gw}" > /tmp/${nic}.gw

[ -n "${br}" ] || br="net${idx}"

ip link add "${br}" type bridge 2>/dev/null || true
if [ "${nic}" == "eth0" ]; then
  #ip addr add 169.254.40.1/30 dev ${br}
  ip link set "${br}" up mtu 1460 master mgmt
else
  ip link set "${br}" up mtu 1460
fi

ip addr del "${ip}" dev "${nic}" 2>/dev/null || true
ip link set "${nic}" master "${br}"
ip link set "${tap}" master "${br}" mtu 1460 up
