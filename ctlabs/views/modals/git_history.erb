<!-- Git Version History Modal -->
<div id="git-history-modal" class="w3-modal" style="z-index: 10002; padding: 2vh 2vw; box-sizing: border-box; overflow: hidden;">
  <div class="w3-modal-content w3-round-large w3-card-4" style="background-color: #1e293b; color: #f8fafc; width: 100%; max-width: 1100px; height: 88vh; margin: 0 auto; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);">
    <header class="w3-container" style="background-color: #0f172a; border-top-left-radius: 8px; border-top-right-radius: 8px; padding: 12px 18px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; flex: none;">
      <h3 style="margin: 0; font-size: 1.1em; font-weight: 600; color: #38bdf8; display: flex; align-items: center; gap: 8px;">
        <i class="fas fa-history"></i> Version History (Git)
        <span id="git-history-scope-badge" style="font-size: 0.75em; background: #334155; color: #cbd5e1; padding: 2px 8px; border-radius: 12px; font-weight: 400;">Set: All</span>
      </h3>
      <span onclick="document.getElementById('git-history-modal').style.display='none'" class="w3-button w3-display-topright w3-hover-red" style="cursor: pointer; background: transparent; color: #94a3b8; font-size: 1.2em; padding: 10px 16px; border-top-right-radius: 8px;">&times;</span>
    </header>

    <!-- Commit / Snapshot Bar -->
    <div style="background: #131d31; padding: 10px 18px; border-bottom: 1px solid #334155; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; flex: none;">
      <input type="text" id="git-snapshot-msg" placeholder="Commit message (e.g. Added section on container overlay)..." style="flex: 1; min-width: 220px; background: #0f172a; border: 1px solid #475569; color: #f8fafc; padding: 6px 12px; border-radius: 4px; font-size: 0.88em;" />
      <button type="button" id="git-snapshot-btn" onclick="createGitSnapshot()" class="w3-button w3-round" style="background: #10b981; color: #ffffff; font-size: 0.85em; padding: 6px 14px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;" title="Commit changes to Git">
        <i class="fas fa-code-branch"></i> Commit Changes
      </button>
      <button type="button" onclick="loadGitHistory()" class="w3-button w3-round" style="background: #334155; color: #cbd5e1; font-size: 0.85em; padding: 6px 12px; display: inline-flex; align-items: center; gap: 6px;" title="Refresh history & working tree status">
        <i class="fas fa-sync-alt"></i> Refresh
      </button>
    </div>

    <!-- Body: Commits List & Diff Inspector -->
    <div style="display: flex; flex: 1; min-height: 0; overflow: hidden;">
      <!-- Left: Commits List -->
      <div style="width: 380px; flex: none; border-right: 1px solid #334155; display: flex; flex-direction: column; background: #0f172a;">
        <div style="padding: 8px 14px; border-bottom: 1px solid #1e293b; color: #94a3b8; font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; display: flex; justify-content: space-between; align-items: center;">
          <span>Revisions Log</span>
          <span id="git-working-tree-badge" style="display: none; background: #78350f; color: #fde68a; padding: 1px 6px; border-radius: 3px; font-size: 0.85em; text-transform: none; font-weight: 500;">
            <i class="fas fa-pencil-alt" style="margin-right: 3px;"></i> Uncommitted
          </span>
        </div>
        <div id="git-history-list" style="flex: 1; overflow-y: auto; padding: 6px 8px; display: flex; flex-direction: column; gap: 6px;">
          <div style="color: #64748b; font-size: 0.85em; text-align: center; padding: 20px;">Loading revisions...</div>
        </div>
      </div>

      <!-- Right: Diff Inspector -->
      <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; background: #1e293b;">
        <div id="git-diff-header" style="padding: 10px 16px; border-bottom: 1px solid #334155; background: #131d31; display: flex; align-items: center; justify-content: space-between; gap: 10px;">
          <div>
            <span id="git-diff-title" style="font-weight: 600; color: #f8fafc; font-size: 0.92em;">Select a revision to view diff</span>
            <div id="git-diff-meta" style="color: #94a3b8; font-size: 0.78em; margin-top: 2px;"></div>
          </div>
          <div id="git-diff-actions" style="display: none; align-items: center; gap: 8px;">
            <button type="button" id="git-discard-btn" onclick="discardWorkingTreeChanges()" class="w3-button w3-round" style="display: none; background: #7f1d1d; color: #fecaca; font-size: 0.82em; padding: 4px 12px; font-weight: 700; align-items: center; gap: 5px;" title="Discard uncommitted working tree changes">
              <i class="fas fa-undo"></i> Discard Changes
            </button>
            <button type="button" id="git-restore-btn" onclick="restoreGitVersion()" class="w3-button w3-round" style="background: #eab308; color: #0f172a; font-size: 0.82em; padding: 4px 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 5px;">
              <i class="fas fa-undo"></i> Restore This Version
            </button>
          </div>
        </div>
        <div id="git-diff-body" style="flex: 1; overflow: auto; padding: 14px 16px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.82em; line-height: 1.45; white-space: pre-wrap; color: #cbd5e1; background: #0b1120;">
          <span style="color: #64748b;">Select a commit from the list on the left to inspect file changes and unified diffs.</span>
        </div>
      </div>
    </div>

    <footer style="padding: 10px 18px; background: #0f172a; border-top: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; flex: none;">
      <span style="color: #64748b; font-size: 0.8em;"><i class="fas fa-shield-alt"></i> Video files (.webm, .mp4) are excluded from git versioning</span>
      <button type="button" onclick="document.getElementById('git-history-modal').style.display='none'" class="w3-button w3-round" style="background: #475569; color: #f8fafc; font-size: 0.85em; padding: 6px 14px;">Close</button>
    </footer>
  </div>
</div>
