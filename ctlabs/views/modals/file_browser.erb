<style>
  .unified-file-item-row {
    padding: 7px 12px;
    border-radius: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    transition: background 0.15s ease;
    font-size: 0.88em;
    border-bottom: 1px solid #1e293b;
    user-select: none;
  }
  .unified-file-item-row:hover {
    background-color: #334155;
  }
  .unified-file-item-row.selected {
    background-color: #0284c7 !important;
    color: #ffffff !important;
  }
  .unified-file-item-row.selected span,
  .unified-file-item-row.selected i {
    color: #ffffff !important;
  }
  .unified-breadcrumb-btn {
    background: transparent;
    border: none;
    color: #38bdf8;
    cursor: pointer;
    padding: 2px 5px;
    border-radius: 3px;
    font-family: monospace;
    font-size: 0.88em;
    transition: background 0.15s;
  }
  .unified-breadcrumb-btn:hover {
    background: #334155;
    text-decoration: underline;
  }
  .unified-badge {
    font-size: 0.75em;
    padding: 2px 6px;
    border-radius: 4px;
    background: #1e293b;
    color: #94a3b8;
    font-family: monospace;
    text-transform: uppercase;
  }
</style>

<div id="unified-file-browser-modal" class="w3-modal" style="z-index: 10000; padding-top: 8vh;">
  <div class="w3-modal-content w3-round-large w3-card-4" style="background-color: #1e293b; color: #f8fafc; max-width: 650px; display: flex; flex-direction: column; max-height: 82vh; border: 1px solid #334155;">
    
    <header class="w3-container w3-padding" style="border-bottom: 1px solid #334155; background-color: #0f172a; border-radius: 12px 12px 0 0; flex-shrink: 0; display: flex; justify-content: space-between; align-items: center;">
      <h4 style="margin: 0; font-size: 1.1em; display: flex; align-items: center; gap: 8px;">
        <i class="fas fa-folder-tree" style="color: #38bdf8;"></i>
        <span>Browse Workspace Files</span>
      </h4>
      <span onclick="document.getElementById('unified-file-browser-modal').style.display='none'" class="w3-button w3-display-topright w3-hover-red w3-round" style="color: #cbd5e1; font-size: 1.2em;">&times;</span>
    </header>

    <!-- Breadcrumb & Refresh Bar -->
    <div class="w3-container w3-padding-small" style="background-color: #0f172a; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; padding-left: 12px; padding-right: 12px;">
      <div id="unified-dir-breadcrumbs" style="display: flex; align-items: center; gap: 4px; overflow-x: auto; white-space: nowrap; flex: 1; min-width: 0; padding: 2px 0;">
        <button class="unified-breadcrumb-btn" onclick="window.navigateUnifiedDir('')"><i class="fas fa-home"></i> root</button>
      </div>
      <button type="button" onclick="window.refreshUnifiedFileBrowser()" style="background: transparent; border: none; color: #38bdf8; cursor: pointer; font-size: 0.82em; display: flex; align-items: center; gap: 5px; flex-shrink: 0; margin-left: 8px;" title="Refresh workspace files">
        <i class="fas fa-sync-alt"></i> Refresh
      </button>
    </div>

    <!-- Search filter bar -->
    <div class="w3-container w3-padding-small" style="flex-shrink: 0; background-color: #0f172a; padding-left: 12px; padding-right: 12px;">
      <div style="position: relative;">
        <i class="fas fa-search" style="position: absolute; left: 10px; top: 9px; color: #64748b; font-size: 0.85em;"></i>
        <input type="text" id="unified-file-search" class="w3-input w3-small w3-round" placeholder="Search files across workspace..." onkeyup="window.filterUnifiedFileBrowser()" style="background-color: #1e293b; color: #e2e8f0; border: 1px solid #475569; padding-left: 30px;">
      </div>
    </div>

    <!-- File list container -->
    <div id="unified-file-list" class="slim-scroll" style="flex: 1; overflow-y: auto; background-color: #0f172a; border-top: 1px solid #334155; border-bottom: 1px solid #334155; min-height: 280px; max-height: 420px; padding: 4px;">
    </div>

    <!-- Selected Path input -->
    <div class="w3-container w3-padding" style="flex-shrink: 0; background-color: #1e293b;">
      <label style="font-size: 0.82em; color: #94a3b8; display: flex; justify-content: space-between;">
        <span>Selected Path (or type a new relative path to create):</span>
        <span id="unified-current-dir-hint" style="color: #64748b; font-family: monospace;"></span>
      </label>
      <input type="text" id="unified-file-input" class="w3-input w3-small w3-round" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569; margin-top: 4px;" placeholder="e.g. playbooks/init.yml">
    </div>

    <!-- Modal Footer -->
    <footer class="w3-container w3-padding" style="border-top: 1px solid #334155; background-color: #0f172a; border-radius: 0 0 12px 12px; display: flex; justify-content: flex-end; gap: 8px; flex-shrink: 0;">
      <button onclick="document.getElementById('unified-file-browser-modal').style.display='none'" class="w3-button w3-round w3-small" style="background-color: #475569; color: #f8fafc;">Cancel</button>
      <button onclick="window.confirmUnifiedFileBrowser()" class="w3-button w3-blue w3-round w3-small" style="display: flex; align-items: center; gap: 6px;">
        <i class="fas fa-folder-open"></i> Open / Create
      </button>
    </footer>
  </div>
</div>
