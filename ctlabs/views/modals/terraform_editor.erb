<%
  # See ansible_editor.erb - the modal serves both the lab and the controller,
  # so both terraform_profiles.yml variants are rendered as data-* attributes.
  terraform_file_label = lambda do |path|
    label = path.dup
    label << ' (box-local override active)' if path.start_with?('/root/.ctlabs/')
    label << (File.file?(path) ? ' (exists)' : ' (MISSING)')
    label
  end
%>

<style>
  .file-list-item { cursor: pointer; padding: 6px 12px; border-bottom: 1px solid #334155; display: flex; align-items: center; gap: 8px; transition: background 0.2s; }
  .file-list-item:hover { background-color: #334155; }
  .file-list-item.selected { background-color: #0284c7; color: white; }

  .tf-browser-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 0.85em;
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease;
    border-bottom: 1px solid rgba(51, 65, 85, 0.4);
  }
  .tf-browser-row:hover { background-color: #1e293b; }
  .tf-browser-row.selected { background-color: #1e3a8a; }

  .tf-crumb-btn {
    background: #1e293b;
    border: 1px solid #334155;
    color: #cbd5e1;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.82em;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s;
  }
  .tf-crumb-btn:hover { background: #334155; color: #f8fafc; border-color: #38bdf8; }
  .tf-crumb-btn.active { background: #0284c7; color: #fff; border-color: #38bdf8; font-weight: 600; }

  label             { font-size: 0.85em; color: #94a3b8; }
  input.w3-input    { font-family: monospace !important; }
  textarea.w3-input { font-family: monospace !important; }
  select.w3-select  { font-family: monospace !important; }
</style>

<div id="terraform-editor-modal" class="w3-modal" style="z-index: 9999; padding-top: 5vh;">
  <div class="w3-modal-content w3-round-large w3-card-4" style="background-color: #1e293b; color: #f8fafc; width: 90%; max-width: 1400px; max-height: 90vh; display: flex; flex-direction: column;">
    
    <header class="w3-container w3-padding" style="border-bottom: 1px solid #334155; background-color: #0f172a; border-radius: 12px 12px 0 0; flex-shrink: 0;">
      <span onclick="document.getElementById('terraform-editor-modal').style.display='none'" class="w3-button w3-display-topright w3-hover-red w3-round" style="color: #cbd5e1;">&times;</span>
      <h4 style="margin: 0;"><i class="fas fa-cubes w3-text-purple"></i> Edit Terraform Config</h4>
    </header>

    <div class="w3-bar slim-scroll" id="tf-tab-bar" style="background-color: #0f172a; border-bottom: 1px solid #334155; display: flex; overflow-x: auto; flex-shrink: 0;">
      <button class="w3-bar-item w3-button tf-tablink w3-text-blue" data-pinned="1" data-target-tab="TfSettings" onclick="window.openTfTab('TfSettings')" style="flex-shrink: 0; background-color: #1e293b; border-bottom: 2px solid #38bdf8;"><i class="fas fa-sliders-h w3-text-blue"></i> Settings</button>
      <button class="w3-bar-item w3-button tf-tablink w3-text-purple" data-pinned="1" data-target-tab="TfCommands" onclick="window.openTfTab('TfCommands')" style="flex-shrink: 0;"><i class="fas fa-terminal w3-text-teal"></i> Execution Script</button>
      <button class="w3-bar-item w3-button tf-tablink" data-pinned="1" data-target-tab="TfAuthProfiles" onclick="window.openTfTab('TfAuthProfiles')" style="flex-shrink: 0;"><i class="fas fa-id-badge w3-text-orange"></i> Auth Profiles</button>
      <button class="w3-bar-item w3-button w3-text-green w3-hover-text-light-green" onclick="window.openUnifiedBrowser('terraform')" title="Browse Workspace" style="flex-shrink: 0;"><i class="fas fa-plus"></i></button>
    </div>

    <div class="w3-container w3-padding slim-scroll" id="tf-editors-container" style="flex: 1; overflow-y: auto; min-height: 400px;">
      
      <div id="TfSettings" class="tf-tab">
        <div class="w3-margin-bottom">
          <label style="font-size: 0.85em; color: #94a3b8;">Repository / Root Directory</label>
          <input type="text" id="edit-terraform-root-dir" list="available-terraform-repos" class="w3-input w3-small w3-round" placeholder="/root/ctlabs-terraform" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;">
          <datalist id="available-terraform-repos"></datalist>
        </div>

        <label style="font-size: 0.85em; color: #94a3b8;">Working Directory (Relative to repository root)</label>
        
        <div style="display: flex; gap: 8px; margin-bottom: 16px;">
          <input type="text" id="edit-terraform-workdir" class="w3-input w3-small w3-round" placeholder="(root directory)" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569; flex: 1;">
          <button type="button" onclick="window.openTerraformDirBrowser()" class="w3-button w3-blue w3-round w3-small" style="white-space: nowrap;"><i class="fas fa-folder-open"></i> Browse</button>
          <button type="button" onclick="window.loadTerraformFiles()" class="w3-button w3-green w3-round w3-small" style="white-space: nowrap;"><i class="fas fa-sync-alt"></i> Load</button>
        </div>

        <div class="w3-margin-bottom">
          <label style="font-size: 0.85em; color: #94a3b8;">Workspace (Default: default)</label>
          <input type="text" id="edit-terraform-workspace" class="w3-input w3-small w3-round" placeholder="default" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;">
        </div>

        <div class="w3-margin-bottom w3-padding w3-round" style="background-color: rgba(16, 185, 129, 0.05); border: 1px solid #334155;">
          <h6 style="margin-top: 0; color: #10b981; font-weight: bold;"><i class="fas fa-lock"></i> GCP Authentication</h6>

          <div class="w3-margin-bottom">
            <label style="font-size: 0.85em; color: #94a3b8;">Auth Method</label>
            <select id="edit-terraform-auth-method" class="w3-select w3-small w3-round" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;" onchange="window.updateTfAuthMethodUI()">
              <option value="">Disabled</option>
              <option value="env">Environment Variables (e.g. GOOGLE_APPLICATION_CREDENTIALS)</option>
              <option value="vault">Vault GCP Secrets Engine (dynamic/static secrets)</option>
              <option value="wif">Workload Identity Federation (via Vault OIDC)</option>
              <option value="profile">Named Profile (see Auth Profiles tab)</option>
            </select>
          </div>

          <div id="tf-auth-env-fields" style="display:none;">
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">Credentials File Path (GOOGLE_APPLICATION_CREDENTIALS)</label>
              <div style="display: flex; gap: 8px;">
                <input type="text" id="edit-terraform-env-credentials" class="w3-input w3-small w3-round" placeholder="e.g. credentials.json or /srv/ctlabs/ctlabs-terraform/key.json" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569; flex: 1;">
                <button type="button" onclick="window.openTerraformDirBrowser('edit-terraform-env-credentials', { mode: 'file', title: 'Select Credentials File' })" class="w3-button w3-blue w3-round w3-small" style="white-space: nowrap;"><i class="fas fa-folder-open"></i> Browse</button>
              </div>
              <div style="font-size: 0.78em; color: #64748b; margin-top: 2px;"><i class="fas fa-info-circle"></i> Relative paths are resolved relative to <code>/srv/ctlabs/ctlabs-terraform</code> inside the container.</div>
              <div id="tf-auth-terminal-env-hint" style="display: none;"></div>
            </div>
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">GCP Project ID (Optional - sets GOOGLE_CLOUD_PROJECT)</label>
              <input type="text" id="edit-terraform-env-project" class="w3-input w3-small w3-round" placeholder="e.g. my-gcp-project" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;">
            </div>
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">Extra Environment Variables (Optional - one per line: KEY=VALUE)</label>
              <textarea id="edit-terraform-env-extra" class="w3-input w3-small w3-round slim-scroll" rows="3" placeholder="GOOGLE_REGION=us-central1&#10;TF_LOG=INFO" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569; font-family: monospace; resize: vertical;"></textarea>
            </div>
          </div>

          <div id="tf-auth-vault-fields" style="display:none;">
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">GCP Project ID</label>
              <input type="text" id="edit-terraform-vault-project" class="w3-input w3-small w3-round" placeholder="my-gcp-project" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;">
            </div>
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">Vault Roleset</label>
              <input type="text" id="edit-terraform-vault-roleset" class="w3-input w3-small w3-round" placeholder="e.g., terraform-runner" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;">
            </div>
          </div>

          <div id="tf-auth-wif-fields" style="display:none;">
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">Vault OIDC Role</label>
              <input type="text" id="edit-terraform-wif-vault-role" class="w3-input w3-small w3-round" placeholder="e.g., gcp-wif" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;">
            </div>
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">WIF Provider Audience</label>
              <input type="text" id="edit-terraform-wif-audience" class="w3-input w3-small w3-round" placeholder="//iam.googleapis.com/projects/.../workloadIdentityPools/.../providers/..." style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;">
            </div>
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">Impersonated Service Account</label>
              <input type="text" id="edit-terraform-wif-service-account" class="w3-input w3-small w3-round" placeholder="terraform-runner@my-project.iam.gserviceaccount.com" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;">
            </div>
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">OAuth Scopes (one per line, default: cloud-platform)</label>
              <textarea id="edit-terraform-wif-scopes" class="w3-input w3-small w3-round slim-scroll" rows="3" placeholder="https://www.googleapis.com/auth/cloud-platform&#10;https://www.googleapis.com/auth/spreadsheets" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569; font-family: monospace; resize: vertical;"></textarea>
              <div style="font-size: 0.78em; color: #64748b; margin-top: 2px;"><i class="fas fa-info-circle"></i> Only grants access to Workspace resources explicitly shared with the service account's own email - not domain-wide access.</div>
            </div>
          </div>

          <div id="tf-auth-profile-fields" style="display:none;">
            <div class="w3-margin-bottom">
              <label style="font-size: 0.85em; color: #94a3b8;">Profile Name</label>
              <input type="text" id="edit-terraform-auth-profile" class="w3-input w3-small w3-round" placeholder="e.g., gcp-wif-default" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569;">
            </div>
          </div>
        </div>

        <div class="w3-row-padding" style="margin: 0 -8px;">
          <div class="w3-margin-bottom">
            <label style="font-size: 0.85em; color: #94a3b8;">Variables (One per line: key=value)</label>
            <textarea id="edit-terraform-vars" class="w3-input w3-small w3-round slim-scroll" rows="6" placeholder="project_id=my-gcp-project&#10;region=us-central1" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569; font-family: monospace; resize: vertical;"></textarea>
          </div>
        </div>
      </div>

      <div id="TfCommands" class="tf-tab" style="display:none; height:100%; flex-direction:column;">
        <div class="w3-padding w3-small" style="background-color: #0f172a; border-bottom: 1px solid #334155; color: #94a3b8; flex-shrink: 0;">
          <i class="fas fa-info-circle"></i> Enter custom shell commands to override the standard <code>terraform init && terraform apply</code> workflow. Leave blank to use the default execution.
        </div>
        <div style="flex-grow: 1; height: 100%;">
          <textarea id="edit-terraform-commands"></textarea>
        </div>
      </div>

      <div id="TfAuthProfiles" class="tf-tab" style="display:none;">
        <div class="w3-panel w3-pale-blue w3-leftbar w3-border-blue w3-small w3-text-black" style="padding: 8px; margin-top: 0;">
          <i class="fas fa-info-circle"></i> Global file: <code data-lab-label="<%= terraform_file_label.call(Automation.terraform_profiles_path) %>" data-ctl-label="<%= terraform_file_label.call(Automation.terraform_profiles_ctl_path) %>"><%= terraform_file_label.call(Automation.terraform_profiles_path) %></code> — reusable named GCP auth configs, selected per-lab via Auth Method &rarr; Named Profile. Applied on next terraform run / terminal open.
        </div>
        <textarea id="editor-TfAuthProfiles"></textarea>
      </div>

      <div id="terraform-editor-result" class="w3-panel w3-round" style="display:none; font-size: 0.9em; padding: 8px; margin-top: 15px;"></div>
    </div>
    
    <footer class="w3-container w3-padding" style="border-top: 1px solid #334155; background-color: #0f172a; border-radius: 0 0 12px 12px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
      <div>
        <button type="button" id="tf-delete-file-btn" onclick="window.deleteActiveTerraformFile()" class="w3-button w3-red w3-round w3-small" style="display: none;"><i class="fas fa-trash"></i> Delete File</button>
      </div>
      <div>
        <button type="button" onclick="document.getElementById('terraform-editor-modal').style.display='none'" class="w3-button w3-round w3-small" style="background-color: #475569;">Cancel</button>
        <button type="button" id="tf-save-btn" onclick="window.saveTerraformConfig()" class="w3-button w3-green w3-round w3-small"><i class="fas fa-save"></i> Save All Files</button>
      </div>
    </footer>
  </div>
</div>

<div id="tf-dir-browser-modal" class="w3-modal" style="z-index: 10000; padding-top: 5vh;">
  <div class="w3-modal-content w3-round-large w3-card-4" style="background-color: #1e293b; color: #f8fafc; width: 90%; max-width: 680px; max-height: 85vh; display: flex; flex-direction: column;">
    
    <header class="w3-container w3-padding" style="border-bottom: 1px solid #334155; background-color: #0f172a; border-radius: 12px 12px 0 0; flex-shrink: 0;">
      <span onclick="document.getElementById('tf-dir-browser-modal').style.display='none'" class="w3-button w3-display-topright w3-hover-red w3-round" style="color: #cbd5e1;">&times;</span>
      <h4 style="margin: 0;"><i class="fas fa-folder-open w3-text-blue"></i> <span id="tf-dir-browser-title">Browse Terraform Workspace</span></h4>
    </header>

    <!-- Breadcrumbs Bar -->
    <div id="tf-dir-breadcrumbs" class="slim-scroll" style="display: flex; align-items: center; gap: 6px; flex-wrap: nowrap; overflow-x: auto; background-color: #0f172a; padding: 8px 12px; border-bottom: 1px solid #334155; font-size: 0.85em; font-family: monospace; flex-shrink: 0;">
      <!-- Populated dynamically -->
    </div>

    <!-- Search / Filter & Actions Bar -->
    <div style="padding: 8px 12px; background-color: #1e293b; border-bottom: 1px solid #334155; display: flex; gap: 8px; align-items: center; flex-shrink: 0;">
      <div style="position: relative; flex: 1;">
        <i class="fas fa-search" style="position: absolute; left: 10px; top: 9px; color: #64748b; font-size: 0.85em;"></i>
        <input type="text" id="tf-dir-search-input" class="w3-input w3-small w3-round" placeholder="Filter folders and files..." style="background-color: #0f172a; color: #f8fafc; border: 1px solid #475569; padding-left: 30px;" oninput="window.filterTerraformBrowserItems()">
      </div>
      <button type="button" id="tf-dir-select-curr-folder-btn" onclick="window.selectCurrentTfBrowserFolder()" class="w3-button w3-blue w3-round w3-small" style="white-space: nowrap;">
        <i class="fas fa-check"></i> Select Current Folder
      </button>
    </div>

    <!-- Items List Container -->
    <div id="tf-dir-items-container" class="slim-scroll" style="flex: 1; overflow-y: auto; padding: 6px 12px; min-height: 280px; max-height: 420px; background-color: #0f172a;">
      <!-- Populated dynamically -->
    </div>
    
    <footer class="w3-container w3-padding" style="border-top: 1px solid #334155; background-color: #0f172a; border-radius: 0 0 12px 12px; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
      <div style="display: flex; align-items: center; gap: 6px; font-size: 0.85em; min-width: 0; overflow: hidden; margin-right: 8px;">
        <span style="color: #94a3b8; white-space: nowrap;">Selected:</span>
        <code id="tf-dir-browser-selected" style="color: #38bdf8; background-color: #1e293b; padding: 2px 8px; border-radius: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 320px;">(root)</code>
      </div>
      <div style="display: flex; gap: 8px; flex-shrink: 0;">
        <button type="button" onclick="document.getElementById('tf-dir-browser-modal').style.display='none'" class="w3-button w3-round w3-small" style="background-color: #475569;">Cancel</button>
        <button type="button" id="tf-dir-confirm-btn" onclick="window.confirmTerraformDirBrowser()" class="w3-button w3-blue w3-round w3-small"><i class="fas fa-check"></i> <span id="tf-dir-confirm-label">Select & Load</span></button>
      </div>
    </footer>
    
  </div>
</div>
