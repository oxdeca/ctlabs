              <option value="erb_raft">Distributed Consensus / Raft Protocol (Amber)</option>
              <option value="erb_data_pipeline">Big Data &amp; Real-Time Analytics Pipeline</option>
              <option value="erb_erd">Relational Database Schema / ERD (Clean Light)</option>
              <option value="erb_c4">C4 Container Architecture Overview</option>
              <option value="erb_dynamic_loop">Dynamic Server Farm Loop (Ruby)</option>
            </optgroup>
            <optgroup label="Processes, Flowcharts &amp; Lifecycle">
