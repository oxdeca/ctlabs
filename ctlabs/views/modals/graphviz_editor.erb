          </label>
          <select id="md-graphviz-new-theme-select" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; border-radius: 4px; padding: 7px 10px; color: #f8fafc; font-size: 0.9em; cursor: pointer;">
            <option value="auto" selected>Auto (from Template)</option>
            <option value="slate">🌌 Cyber Slate (Dark Blue)</option>
            <option value="light">📄 Clean Paper (Light)</option>
            <option value="nord">❄️ Nord Arctic (Cyan / Frost)</option>
