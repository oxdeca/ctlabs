<!-- Graphviz Diagram Modal -->
<div id="md-graphviz-modal" class="w3-modal" style="z-index: 10001; padding: 2vh 2vw; box-sizing: border-box; overflow: hidden;">
  <div class="w3-modal-content w3-round-large w3-card-4" style="background-color: #1e293b; color: #f8fafc; width: 100%; max-width: none; height: 100%; max-height: none; margin: 0 auto; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);">
    <header class="w3-container" style="background-color: #0f172a; border-top-left-radius: 8px; border-top-right-radius: 8px; padding: 12px 16px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; flex: none;">
      <h3 style="margin: 0; font-size: 1.1em; font-weight: 600; color: #38bdf8; display: flex; align-items: center; gap: 8px;"><i class="fas fa-project-diagram"></i> Graphviz Diagram</h3>
      <span onclick="document.getElementById('md-graphviz-modal').style.display='none'" class="w3-button w3-display-topright w3-hover-red" style="cursor: pointer; background: transparent; color: #94a3b8; font-size: 1.2em; padding: 10px 16px; border-top-right-radius: 8px;">&times;</span>
    </header>
    <div style="padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; flex: 1; min-height: 0;">
      <div style="display: flex; gap: 10px; flex-wrap: wrap; flex: none;">
        <div style="flex: 1 1 200px; min-width: 160px;">
          <label for="md-graphviz-name" style="display: block; color: #f8fafc; font-size: 0.85em; font-weight: 600; margin-bottom: 6px;">Diagram name</label>
          <input type="text" id="md-graphviz-name" placeholder="diagram" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; color: #f8fafc; padding: 8px 12px; border-radius: 4px; font-size: 0.9em;" />
        </div>
        <div style="flex: 1 1 200px; min-width: 160px;">
          <label for="md-graphviz-existing" style="display: block; color: #f8fafc; font-size: 0.85em; font-weight: 600; margin-bottom: 6px;">Edit saved diagram</label>
          <select id="md-graphviz-existing" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; color: #f8fafc; padding: 8px 12px; border-radius: 4px; font-size: 0.9em;">
            <option value="">New diagram</option>
          </select>
        </div>
        <div style="flex: 0 1 160px; min-width: 130px;">
          <label for="md-graphviz-engine" style="display: block; color: #f8fafc; font-size: 0.85em; font-weight: 600; margin-bottom: 6px;">Layout engine</label>
          <select id="md-graphviz-engine" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; color: #f8fafc; padding: 8px 12px; border-radius: 4px; font-size: 0.9em;">
            <option value="dot" selected>dot (hierarchical)</option>
            <option value="neato">neato (spring model)</option>
            <option value="fdp">fdp (force-directed)</option>
            <option value="sfdp">sfdp (large graphs)</option>
            <option value="circo">circo (circular)</option>
            <option value="twopi">twopi (radial)</option>
            <option value="osage">osage (clustered)</option>
            <option value="patchwork">patchwork (treemap)</option>
          </select>
        </div>
        <div style="flex: 0 1 200px; min-width: 170px;">
          <label for="md-graphviz-template" style="display: block; color: #f8fafc; font-size: 0.85em; font-weight: 600; margin-bottom: 6px;">Insert template</label>
          <select id="md-graphviz-template" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; color: #f8fafc; padding: 8px 12px; border-radius: 4px; font-size: 0.9em;">
            <option value="">Select template…</option>
            <optgroup label="ERB Topology Templates (Building Blocks)">
              <option value="erb_enterprise">Enterprise Network (ERB)</option>
              <option value="erb_k8s">Kubernetes Cluster (ERB)</option>
              <option value="erb_microservices">Microservices &amp; DBs (ERB)</option>
              <option value="erb_dynamic_loop">Dynamic Hosts Loop (ERB)</option>
            </optgroup>
            <optgroup label="Classic DOT Templates">
              <option value="flowchart_lr">Flowchart (LR)</option>
              <option value="flowchart_tb">Flowchart (TB)</option>
              <option value="network">Network Topology</option>
              <option value="state_machine">State Machine</option>
              <option value="records">Data Structures / Record</option>
            </optgroup>
          </select>
        </div>
        <div style="flex: 0 0 auto;">
          <label for="md-graphviz-bg" style="display: block; color: #f8fafc; font-size: 0.85em; font-weight: 600; margin-bottom: 6px;">Preview BG</label>
          <div style="display: inline-flex; align-items: center; background: #0f172a; border: 1px solid #475569; border-radius: 4px; padding: 2px; height: 38px; box-sizing: border-box; gap: 4px;">
            <button type="button" id="md-graphviz-bg-white" title="White background" style="width: 26px; height: 26px; border-radius: 3px; border: 2px solid #38bdf8; background: #ffffff; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding: 0;"></button>
            <button type="button" id="md-graphviz-bg-slate" title="Slate dark background" style="width: 26px; height: 26px; border-radius: 3px; border: 1px solid #475569; background: #0f172a; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding: 0;"></button>
            <button type="button" id="md-graphviz-bg-checker" title="Transparent checkerboard background" style="width: 26px; height: 26px; border-radius: 3px; border: 1px solid #475569; background: repeating-conic-gradient(#cbd5e1 0% 25%, #f1f5f9 0% 50%) 50% / 8px 8px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding: 0;"></button>
            <label title="Custom color picker" style="width: 26px; height: 26px; border-radius: 3px; border: 1px solid #475569; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; position: relative; overflow: hidden; margin: 0; background: #334155;">
              <i class="fas fa-eye-dropper" style="font-size: 11px; color: #94a3b8; pointer-events: none;"></i>
              <input type="color" id="md-graphviz-bg-picker" value="#ffffff" style="opacity: 0; position: absolute; inset: 0; width: 100%; height: 100%; cursor: pointer;" />
            </label>
          </div>
        </div>
        <div style="flex: 0 0 auto;">
          <label style="display: block; color: #f8fafc; font-size: 0.85em; font-weight: 600; margin-bottom: 6px;">Panes</label>
          <div style="display: inline-flex; align-items: center; background: #0f172a; border: 1px solid #475569; border-radius: 4px; padding: 2px; height: 38px; box-sizing: border-box;">
            <button type="button" id="md-graphviz-layout-side" title="Side by side: Source left, Preview right" style="padding: 4px 10px; font-size: 0.82em; border-radius: 3px; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; height: 32px; transition: background 0.15s, color 0.15s; background: #0284c7; color: #ffffff; font-weight: 600;">
              <i class="fas fa-columns"></i>
              <span>Left / Right</span>
            </button>
            <button type="button" id="md-graphviz-layout-stack" title="Stacked: Preview top, Source bottom" style="padding: 4px 10px; font-size: 0.82em; border-radius: 3px; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; height: 32px; transition: background 0.15s, color 0.15s; background: transparent; color: #94a3b8; font-weight: 400;">
              <i class="fas fa-bars"></i>
              <span>Top / Bottom</span>
            </button>
          </div>
        </div>
      </div>
      <div id="md-graphviz-split-container" style="display: flex; flex-direction: row; align-items: stretch; flex: 1; min-height: 0; position: relative;">
        <div id="md-graphviz-source-pane" style="display: flex; flex-direction: column; min-height: 0; min-width: 150px; flex: none; box-sizing: border-box; overflow: visible; position: relative; z-index: 10;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; flex: none; gap: 8px; flex-wrap: wrap;">
            <div style="display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap;">
              <div style="display: inline-flex; align-items: center; background: #0f172a; border: 1px solid #475569; border-radius: 4px; padding: 2px; height: 28px; box-sizing: border-box;">
                <button type="button" id="md-graphviz-tab-source" title="Edit source template" style="padding: 2px 8px; font-size: 0.78em; border-radius: 3px; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; height: 22px; background: #0284c7; color: #ffffff; font-weight: 600; transition: all 0.15s;">
                  <i class="fas fa-edit"></i>
                  <span>Source (ERB)</span>
                </button>
                <button type="button" id="md-graphviz-tab-dot" title="View compiled Graphviz DOT code" style="padding: 2px 8px; font-size: 0.78em; border-radius: 3px; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; height: 22px; background: transparent; color: #94a3b8; font-weight: 500; transition: all 0.15s;">
                  <i class="fas fa-code"></i>
                  <span>Generated DOT</span>
                  <span id="md-graphviz-tab-dot-badge" style="display: none; font-size: 0.7em; padding: 0 4px; border-radius: 8px; background: #0369a1; color: #e0f2fe; margin-left: 2px;">ready</span>
                </button>
              </div>

              <!-- Building Blocks / Snippet Dropdown -->
              <div style="position: relative; display: inline-block;">
                <button type="button" id="md-graphviz-blocks-btn" title="Insert DSL building block snippet" style="height: 28px; padding: 0 9px; border-radius: 4px; border: 1px solid #0284c7; background: #0369a1; color: #ffffff; font-size: 0.78em; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; font-weight: 600; transition: background 0.15s;">
                  <i class="fas fa-cubes"></i>
                  <span>Blocks</span>
                  <i class="fas fa-caret-down" style="font-size: 0.75em;"></i>
                </button>
                <div id="md-graphviz-blocks-menu" style="display: none; position: absolute; left: 0; top: 100%; margin-top: 4px; min-width: 280px; max-height: 440px; overflow-y: auto; background: #0f172a; border: 1px solid #334155; border-radius: 6px; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6); z-index: 100; padding: 4px 0; font-size: 0.8em;">
                  <!-- Dynamic Custom Blocks Section (Global) -->
                  <div id="md-graphviz-custom-blocks-container"></div>

                  <div style="padding: 4px 10px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; color: #a78bfa; font-weight: 700; background: #1e293b; margin-top: 2px;">📐 Layout &amp; Alignment</div>
                  <button type="button" class="md-gv-snippet-item" data-snippet="stack_vertical" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#c084fc;">⬇️ Vertical Stack</span><code style="font-size:0.85em; color:#94a3b8;">invis edge stack</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="same_rank" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#c084fc;">↔️ Same Rank (Row)</span><code style="font-size:0.85em; color:#94a3b8;">{ rank=same; ... }</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="rank_source" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#c084fc;">⬆️ Top Rank (Source)</span><code style="font-size:0.85em; color:#94a3b8;">{ rank=source; ... }</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="rank_sink" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#c084fc;">⬇️ Bottom Rank (Sink)</span><code style="font-size:0.85em; color:#94a3b8;">{ rank=sink; ... }</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="spacer_node" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#c084fc;">👻 Invisible Spacer Node</span><code style="font-size:0.85em; color:#94a3b8;">spacer [invis]</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="invis_edge" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#c084fc;">🌫️ Invisible Edge</span><code style="font-size:0.85em; color:#94a3b8;">a -&gt; b [style=invis]</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="cluster_stack" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#c084fc;">📑 Stack Subgraphs</span><code style="font-size:0.85em; color:#94a3b8;">c1 -&gt; c2 [invis]</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="layout_tb" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#c084fc;">↕️ Rankdir TB (Top-Down)</span><code style="font-size:0.85em; color:#94a3b8;">rankdir="TB";</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="layout_lr" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#c084fc;">↔️ Rankdir LR (Left-Right)</span><code style="font-size:0.85em; color:#94a3b8;">rankdir="LR";</code></button>

                  <div style="padding: 4px 10px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; color: #38bdf8; font-weight: 700; background: #1e293b; margin-top: 4px;">Network &amp; Hardware</div>
                  <button type="button" class="md-gv-snippet-item" data-snippet="host" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#38bdf8;">💻 Host / Server</span><code style="font-size:0.85em; color:#94a3b8;">host(...)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="router" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#f59e0b;">🔀 Router</span><code style="font-size:0.85em; color:#94a3b8;">router(...)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="switch" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#10b981;">🎛️ Switch</span><code style="font-size:0.85em; color:#94a3b8;">switch(...)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="firewall" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#ef4444;">🛡️ Firewall</span><code style="font-size:0.85em; color:#94a3b8;">firewall(...)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="gateway" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#a855f7;">🚪 Gateway</span><code style="font-size:0.85em; color:#94a3b8;">gateway(...)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="cloud" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#0ea5e9;">☁️ Cloud / WAN</span><code style="font-size:0.85em; color:#94a3b8;">cloud(...)</code></button>

                  <div style="padding: 4px 10px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; color: #38bdf8; font-weight: 700; background: #1e293b; margin-top: 4px;">Workloads &amp; Data</div>
                  <button type="button" class="md-gv-snippet-item" data-snippet="database" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#ec4899;">🗄️ Database</span><code style="font-size:0.85em; color:#94a3b8;">database(...)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="k8s_pod" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#38bdf8;">☸️ K8s Pod</span><code style="font-size:0.85em; color:#94a3b8;">k8s_pod(...)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="table_node" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#38bdf8;">📊 Table Record</span><code style="font-size:0.85em; color:#94a3b8;">table_node(...)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="badge" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span style="color:#38bdf8;">🏷️ Pill Badge</span><code style="font-size:0.85em; color:#94a3b8;">badge(...)</code></button>

                  <div style="padding: 4px 10px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; color: #38bdf8; font-weight: 700; background: #1e293b; margin-top: 4px;">Clusters &amp; Edges</div>
                  <button type="button" class="md-gv-snippet-item" data-snippet="cluster" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span>📦 Cluster / Subgraph</span><code style="font-size:0.85em; color:#94a3b8;">cluster(...) do</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="nested_cluster" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span>📦 Nested Clusters</span><code style="font-size:0.85em; color:#94a3b8;">nested cluster</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="link" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span>➡️ Single Link</span><code style="font-size:0.85em; color:#94a3b8;">link(a, b)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="links" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span>🔀 Multi Links</span><code style="font-size:0.85em; color:#94a3b8;">links(from, *to)</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="chain" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span>🔗 Chain</span><code style="font-size:0.85em; color:#94a3b8;">chain(a, b, c)</code></button>

                  <div style="padding: 4px 10px; font-size: 0.75em; text-transform: uppercase; letter-spacing: 0.5px; color: #38bdf8; font-weight: 700; background: #1e293b; margin-top: 4px;">ERB Loops &amp; Logic</div>
                  <button type="button" class="md-gv-snippet-item" data-snippet="loop" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span>🔁 Loop (.each)</span><code style="font-size:0.85em; color:#94a3b8;">&lt;% ...each %&gt;</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="condition" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span>❓ Condition (if/else)</span><code style="font-size:0.85em; color:#94a3b8;">&lt;% if ... %&gt;</code></button>
                  <button type="button" class="md-gv-snippet-item" data-snippet="header" style="display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left; padding: 6px 12px; background: transparent; border: none; color: #cbd5e1; cursor: pointer;"><span>🎨 Graph Header</span><code style="font-size:0.85em; color:#94a3b8;">graph_header(...)</code></button>
                </div>
              </div>

              <!-- Graphviz Emoji Picker Dropdown -->
              <div id="md-graphviz-emoji-wrapper" style="position: relative; display: inline-block;">
                <button type="button" id="md-graphviz-emoji-btn" title="Insert Emoji into diagram (Ctrl+E)" style="height: 28px; padding: 0 9px; border-radius: 4px; border: 1px solid #475569; background: #1e293b; color: #f1f5f9; font-size: 0.78em; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; font-weight: 500; transition: background 0.15s, border-color 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='#1e293b'">
                  <span style="font-size: 1.1em; line-height: 1;">😊</span>
                  <span>Emoji</span>
                  <i class="fas fa-caret-down" style="font-size: 0.75em; color: #94a3b8;"></i>
                </button>

                <div id="md-graphviz-emoji-menu" style="display: none; position: absolute; left: 0; top: 100%; margin-top: 4px; width: 340px; background: #1e293b; border: 1px solid #475569; border-radius: 8px; box-shadow: 0 12px 30px rgba(0,0,0,0.65); z-index: 1000; flex-direction: column; overflow: hidden;">
                  <div style="padding: 8px 10px; background: #0f172a; border-bottom: 1px solid #334155; display: flex; flex-direction: column; gap: 6px;">
                    <div style="display: flex; align-items: center; gap: 6px; background: #1e293b; border: 1px solid #475569; border-radius: 4px; padding: 3px 8px;">
                      <i class="fas fa-search" style="color: #94a3b8; font-size: 0.8em;"></i>
                      <input type="text" id="md-graphviz-emoji-search" placeholder="Search GitHub emojis (e.g. rocket, firewall, +1)..." style="background: transparent; border: none; outline: none; color: #f8fafc; font-size: 0.82em; width: 100%;" autocomplete="off" />
                      <button type="button" id="md-graphviz-emoji-search-clear" style="background: transparent; border: none; color: #94a3b8; cursor: pointer; font-size: 0.85em; display: none; padding: 0 4px;" title="Clear">&times;</button>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: flex-start; gap: 4px;">
                      <div id="md-graphviz-emoji-cat-tabs" style="display: flex; align-items: center; gap: 3px; width: 100%;">
                        <button type="button" class="md-gv-emoji-cat-btn active" data-cat="all" title="Popular & Common" style="padding: 2px 8px; border-radius: 4px; font-size: 0.85em; background: #0284c7; color: #fff; border: none; cursor: pointer;">⚡ All</button>
                        <button type="button" class="md-gv-emoji-cat-btn" data-cat="github" title="GitHub & Octocat" style="padding: 2px 8px; border-radius: 4px; font-size: 0.85em; background: transparent; color: #94a3b8; border: none; cursor: pointer;">🐙 GitHub</button>
                        <button type="button" class="md-gv-emoji-cat-btn" data-cat="status" title="Status & Alerts" style="padding: 2px 8px; border-radius: 4px; font-size: 0.85em; background: transparent; color: #94a3b8; border: none; cursor: pointer;">⚠️ Status</button>
                        <button type="button" class="md-gv-emoji-cat-btn" data-cat="tech" title="Tech & DevOps" style="padding: 2px 8px; border-radius: 4px; font-size: 0.85em; background: transparent; color: #94a3b8; border: none; cursor: pointer;">🚀 Tech</button>
                        <button type="button" class="md-gv-emoji-cat-btn" data-cat="people" title="People & Reactions" style="padding: 2px 8px; border-radius: 4px; font-size: 0.85em; background: transparent; color: #94a3b8; border: none; cursor: pointer;">👍 People</button>
                        <button type="button" class="md-gv-emoji-cat-btn" data-cat="symbols" title="Symbols & Objects" style="padding: 2px 8px; border-radius: 4px; font-size: 0.85em; background: transparent; color: #94a3b8; border: none; cursor: pointer;">⭐ Symbols</button>
                      </div>
                    </div>
                  </div>

                  <div id="md-graphviz-emoji-grid" style="display: grid; grid-template-columns: repeat(8, 1fr); gap: 2px; padding: 8px; max-height: 220px; overflow-y: auto; background: #131d31;">
                  </div>

                  <div style="padding: 6px 10px; background: #0f172a; border-top: 1px solid #334155; display: flex; align-items: center; justify-content: space-between; font-size: 0.74em; color: #94a3b8;">
                    <div id="md-graphviz-emoji-footer-preview" style="color: #cbd5e1; font-family: ui-monospace, monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 175px;">
                      Hover emoji for code
                    </div>
                    <span style="color: #64748b; font-size: 0.88em; white-space: nowrap;">Click: Char · Right-click: :code:</span>
                  </div>
                </div>
              </div>

              <!-- Editor Settings Menu (Wrap, Vim, Font) -->
              <div id="md-graphviz-settings-wrapper" style="position: relative; display: inline-block;">
                <button type="button" id="md-graphviz-settings-btn" title="Editor settings (Wrap, Vim, Font)" style="height: 28px; width: 28px; border-radius: 4px; border: 1px solid #475569; background: #1e293b; color: #cbd5e1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: background 0.15s, border-color 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='#1e293b'">
                  <i class="fas fa-cog" style="color: #94a3b8;"></i>
                </button>
                <div id="md-graphviz-settings-menu" style="display: none; position: absolute; left: 0; top: 100%; margin-top: 4px; min-width: 240px; background: #1e293b; border: 1px solid #475569; border-radius: 6px; box-shadow: 0 10px 25px rgba(0,0,0,0.6); z-index: 1000; overflow: hidden; padding: 4px 0;">
                  <div style="padding: 6px 12px; font-size: 0.72em; text-transform: uppercase; color: #94a3b8; font-weight: 700; letter-spacing: 0.5px; border-bottom: 1px solid #334155; margin-bottom: 4px;">
                    Editor Settings
                  </div>
                  <label id="md-graphviz-setting-wrap-label" style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; cursor: pointer; color: #f8fafc; font-size: 0.84em; user-select: none; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                    <span style="display: flex; align-items: center; gap: 8px;">
                      <i class="fas fa-align-left" style="color: #38bdf8; width: 14px; text-align: center;"></i> Wrap lines
                    </span>
                    <input type="checkbox" id="md-graphviz-setting-wrap-checkbox" style="cursor: pointer; accent-color: #38bdf8; width: 15px; height: 15px;" />
                  </label>
                  <label id="md-graphviz-setting-vim-label" style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; cursor: pointer; color: #f8fafc; font-size: 0.84em; user-select: none; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                    <span style="display: flex; align-items: center; gap: 8px;">
                      <i class="fas fa-terminal" style="color: #22c55e; width: 14px; text-align: center;"></i> Vi / Vim keybindings
                    </span>
                    <input type="checkbox" id="md-graphviz-setting-vim-checkbox" style="cursor: pointer; accent-color: #22c55e; width: 15px; height: 15px;" />
                  </label>
                  <div style="padding: 8px 12px; border-top: 1px solid #334155; margin-top: 4px;">
                    <div style="font-size: 0.82em; color: #cbd5e1; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                      <i class="fas fa-font" style="color: #38bdf8; width: 14px; text-align: center;"></i> Font family
                    </div>
                    <select id="md-graphviz-font-family" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; color: #cbd5e1; padding: 4px 8px; border-radius: 4px; font-size: 0.82em; cursor: pointer;">
                      <option value="courier" selected>Courier</option>
                      <option value="mono">System Monospace</option>
                      <option value="consolas">Consolas / SFMono</option>
                      <option value="fira">Fira Code</option>
                    </select>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 10px;">
                      <span style="font-size: 0.82em; color: #cbd5e1; display: flex; align-items: center; gap: 6px;">
                        <i class="fas fa-text-height" style="color: #38bdf8; width: 14px; text-align: center;"></i> Font size
                      </span>
                      <div style="display: inline-flex; align-items: center; background: #0f172a; border: 1px solid #475569; border-radius: 4px; height: 26px; box-sizing: border-box;">
                        <button type="button" id="md-graphviz-font-dec" title="Decrease editor font size" style="width: 22px; height: 100%; border: none; background: transparent; color: #cbd5e1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85em; font-weight: bold; padding: 0;">&minus;</button>
                        <span id="md-graphviz-font-size-label" style="min-width: 32px; text-align: center; font-size: 0.75em; color: #38bdf8; font-family: monospace; font-weight: 600; user-select: none;">13px</span>
                        <button type="button" id="md-graphviz-font-inc" title="Increase editor font size" style="width: 22px; height: 100%; border: none; background: transparent; color: #cbd5e1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85em; font-weight: bold; padding: 0;">+</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <span style="color: #64748b; font-size: 0.75em;">Tab = indent &middot; Ctrl+S = save &middot; Ctrl+Enter = render</span>
          </div>

          <!-- Main editor container (Source Template) -->
          <div id="md-graphviz-editor-container" style="flex: 1 1 0%; min-height: 0; display: flex; flex-direction: column; position: relative; border: 1px solid #475569; border-radius: 6px; overflow: hidden; background: #0f172a;">
            <textarea id="md-graphviz-source" spellcheck="false" autocomplete="off" style="width: 100%; height: 100%; box-sizing: border-box; flex: 1; min-height: 0; resize: none; background: #0f172a; border: none; color: #e2e8f0; padding: 10px 12px; font-family: 'Courier New', Courier, monospace; font-size: 13px; line-height: 1.45; tab-size: 2; outline: none;"></textarea>
          </div>

          <!-- Compiled Generated DOT container -->
          <div id="md-graphviz-dot-container" style="display: none; flex: 1 1 0%; min-height: 0; flex-direction: column; position: relative; border: 1px solid #475569; border-radius: 6px; overflow: hidden; background: #0b1120;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; background: #0f172a; border-bottom: 1px solid #334155; flex: none;">
              <span style="color: #94a3b8; font-size: 0.78em; font-family: monospace; display: flex; align-items: center; gap: 6px;">
                <i class="fas fa-code" style="color: #38bdf8;"></i> Compiled Graphviz DOT output
              </span>
              <div style="display: flex; align-items: center; gap: 6px;">
                <button type="button" id="md-graphviz-dot-use-btn" title="Replace ERB template with compiled DOT code so you can edit the DOT source directly" style="height: 24px; padding: 0 9px; border-radius: 3px; border: 1px solid #0284c7; background: #0284c7; color: #ffffff; font-size: 0.75em; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; font-weight: 600; transition: all 0.15s;">
                  <i class="fas fa-edit"></i>
                  <span>Use as Source</span>
                </button>
                <button type="button" id="md-graphviz-dot-copy-btn" title="Copy compiled DOT to clipboard" style="height: 24px; padding: 0 9px; border-radius: 3px; border: 1px solid #475569; background: #1e293b; color: #cbd5e1; font-size: 0.75em; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; font-weight: 500; transition: all 0.15s;">
                  <i class="fas fa-copy"></i>
                  <span id="md-graphviz-dot-copy-text">Copy DOT</span>
                </button>
              </div>
            </div>
            <pre id="md-graphviz-dot-output" style="margin: 0; padding: 10px 12px; flex: 1; min-height: 0; overflow: auto; font-family: 'Courier New', Courier, monospace; font-size: 12.5px; line-height: 1.45; color: #e2e8f0; white-space: pre; user-select: text; background: #0b1120;"></pre>
          </div>

          <div id="md-graphviz-vim-status-bar" style="display: none; margin-top: 4px; padding: 3px 10px; background: #0f172a; border: 1px solid #334155; border-radius: 4px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.74em; color: #94a3b8; align-items: center; justify-content: space-between; user-select: none; flex: none;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span id="md-graphviz-vim-status-mode" style="font-weight: 700; color: #22c55e; letter-spacing: 0.5px;">-- NORMAL --</span>
              <span id="md-graphviz-vim-status-key" style="color: #cbd5e1;"></span>
            </div>
            <span style="color: #64748b; font-size: 0.85em;">:w save &bull; :wq save &amp; insert &bull; :q close &bull; Esc normal mode</span>
          </div>
        </div>
        <div id="md-graphviz-splitter" title="Drag to resize panes (double-click to reset 50/50)" style="flex: none; display: flex; align-items: center; justify-content: center; background: #1e293b; transition: background 0.15s ease; user-select: none; touch-action: none; z-index: 5;">
          <i id="md-graphviz-splitter-grip" class="fas fa-grip-vertical" style="color: #64748b; font-size: 10px; pointer-events: none;"></i>
        </div>
        <div id="md-graphviz-preview-pane" style="display: flex; flex-direction: column; min-height: 0; min-width: 150px; flex: 1; box-sizing: border-box;">
          <label style="display: block; color: #f8fafc; font-size: 0.85em; font-weight: 600; margin-bottom: 6px; flex: none;">Preview <span style="color: #64748b; font-weight: 400;">(live &mdash; drag to pan, scroll to zoom)</span></label>
          <div id="md-graphviz-preview" style="position: relative; flex: 1; min-height: 120px; box-sizing: border-box; border: 1px solid #334155; border-radius: 6px; background: #ffffff; overflow: hidden; cursor: grab; touch-action: none; user-select: none;">
            <span id="md-graphviz-preview-empty" style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 0.85em; pointer-events: none;">Render to preview</span>
            <img id="md-graphviz-preview-img" alt="Graphviz preview" draggable="false" style="display: none; position: absolute; left: 0; top: 0; transform-origin: 0 0; max-width: none; max-height: none; user-select: none; -webkit-user-drag: none; will-change: transform;" />
            <div style="position: absolute; top: 8px; right: 8px; display: flex; gap: 4px; z-index: 2;">
              <button type="button" id="md-graphviz-zoom-out" title="Zoom out" style="width: 28px; height: 28px; border-radius: 4px; border: 1px solid #475569; background: rgba(15, 23, 42, 0.9); color: #e2e8f0; cursor: pointer; font-size: 1em; line-height: 1; display: inline-flex; align-items: center; justify-content: center;">&minus;</button>
              <button type="button" id="md-graphviz-zoom-reset" title="Reset to 100%" style="min-width: 48px; height: 28px; padding: 0 8px; border-radius: 4px; border: 1px solid #475569; background: rgba(15, 23, 42, 0.9); color: #e2e8f0; cursor: pointer; font-size: 0.75em; line-height: 1;">100%</button>
              <button type="button" id="md-graphviz-zoom-in" title="Zoom in" style="width: 28px; height: 28px; border-radius: 4px; border: 1px solid #475569; background: rgba(15, 23, 42, 0.9); color: #e2e8f0; cursor: pointer; font-size: 1em; line-height: 1; display: inline-flex; align-items: center; justify-content: center;">+</button>
              <button type="button" id="md-graphviz-zoom-fit" title="Fit diagram to view" style="height: 28px; padding: 0 9px; border-radius: 4px; border: 1px solid #475569; background: rgba(15, 23, 42, 0.9); color: #e2e8f0; cursor: pointer; font-size: 0.75em; line-height: 1;">Fit</button>
            </div>
          </div>
        </div>
      </div>
      <div id="md-graphviz-error" style="display: none; color: #fca5a5; background: #450a0a; border: 1px solid #7f1d1d; border-radius: 6px; padding: 8px 10px; font-size: 0.82em; white-space: pre-wrap; max-height: 120px; overflow: auto;"></div>
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <button type="button" id="md-graphviz-delete-btn" class="w3-button w3-round" style="display: none; background: #7f1d1d; color: #fecaca; font-size: 0.85em; padding: 6px 14px; font-weight: 600; align-items: center; gap: 6px;"><i class="fas fa-trash-alt"></i> Delete Diagram</button>
          <span id="md-graphviz-status" style="color: #94a3b8; font-size: 0.8em;"></span>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
          <button type="button" id="md-graphviz-download-btn" class="w3-button w3-round" style="background: #1e293b; border: 1px solid #475569; color: #cbd5e1; font-size: 0.85em; padding: 6px 14px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-download"></i> Download SVG</button>
          <button type="button" id="md-graphviz-render-btn" class="w3-button w3-round" style="background: #475569; color: #f8fafc; font-size: 0.85em; padding: 6px 14px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-play"></i> Render</button>
          <button type="button" id="md-graphviz-save-new-btn" class="w3-button w3-round" style="display: none; background: #334155; color: #f8fafc; font-size: 0.85em; padding: 6px 14px; font-weight: 600; align-items: center; gap: 6px;"><i class="fas fa-copy"></i> Save as New</button>
          <button type="button" id="md-graphviz-insert-btn" class="w3-button w3-round" style="background: #0284c7; color: #ffffff; font-size: 0.85em; padding: 6px 16px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;"><i id="md-graphviz-insert-icon" class="fas fa-plus"></i> <span id="md-graphviz-insert-text">Save &amp; Insert</span></button>
          <button type="button" id="md-graphviz-close-btn" class="w3-button w3-round" style="background: #1e293b; border: 1px solid #475569; color: #cbd5e1; font-size: 0.85em; padding: 6px 14px; font-weight: 600;">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Custom Block Modal (Create/Edit Global Custom Block) -->
<div id="md-graphviz-block-modal" class="w3-modal" style="z-index: 10000; background: rgba(0, 0, 0, 0.75); display: none;">
  <div class="w3-modal-content w3-round-large" style="background: #1e293b; color: #f8fafc; border: 1px solid #475569; max-width: 600px; width: 92%; margin: 70px auto; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.8);">
    <div style="padding: 12px 18px; background: #0f172a; border-bottom: 1px solid #334155; display: flex; align-items: center; justify-content: space-between;">
      <span style="font-weight: 600; font-size: 0.95em; color: #38bdf8; display: flex; align-items: center; gap: 8px;">
        <i class="fas fa-cube"></i> <span id="md-graphviz-block-modal-title">Global Custom Block</span>
      </span>
      <button type="button" id="md-graphviz-block-modal-close" style="background: transparent; border: none; color: #94a3b8; font-size: 1.2em; cursor: pointer;">&times;</button>
    </div>
    <div style="padding: 16px 18px; display: flex; flex-direction: column; gap: 12px;">
      <div>
        <label style="display: block; font-size: 0.82em; font-weight: 600; color: #cbd5e1; margin-bottom: 4px;">Block / Function Name</label>
        <input type="text" id="md-graphviz-block-name" placeholder="e.g. app_tier, k8s_service" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; border-radius: 4px; padding: 6px 10px; color: #f8fafc; font-size: 0.88em; font-family: monospace;" />
      </div>
      <div>
        <label style="display: block; font-size: 0.82em; font-weight: 600; color: #cbd5e1; margin-bottom: 4px;">Ruby Implementation (<code style="color:#38bdf8;">def name(...) ... end</code>)</label>
        <textarea id="md-graphviz-block-code" placeholder="def my_block(id, label: nil)&#10;  host(id, name: label || id, icon: &quot;💻&quot;)&#10;end" spellcheck="false" style="width: 100%; height: 140px; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; border-radius: 4px; padding: 8px 10px; color: #e2e8f0; font-size: 0.85em; font-family: monospace; line-height: 1.4; resize: vertical;"></textarea>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <div>
          <label style="display: block; font-size: 0.82em; font-weight: 600; color: #cbd5e1; margin-bottom: 4px;">Snippet (inserted into editor)</label>
          <input type="text" id="md-graphviz-block-snippet" placeholder="&lt;%= my_block(&quot;id&quot;) %&gt;" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; border-radius: 4px; padding: 6px 10px; color: #f8fafc; font-size: 0.85em; font-family: monospace;" />
        </div>
        <div>
          <label style="display: block; font-size: 0.82em; font-weight: 600; color: #cbd5e1; margin-bottom: 4px;">Description (optional)</label>
          <input type="text" id="md-graphviz-block-desc" placeholder="e.g. 3-tier app cluster helper" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; border-radius: 4px; padding: 6px 10px; color: #f8fafc; font-size: 0.85em;" />
        </div>
      </div>
      <div id="md-graphviz-block-error" style="display: none; color: #fca5a5; background: #450a0a; border: 1px solid #7f1d1d; border-radius: 4px; padding: 6px 10px; font-size: 0.8em;"></div>
    </div>
    <div style="padding: 10px 18px; background: #0f172a; border-top: 1px solid #334155; display: flex; justify-content: flex-end; gap: 8px;">
      <button type="button" id="md-graphviz-block-cancel-btn" style="background: #1e293b; border: 1px solid #475569; color: #cbd5e1; border-radius: 4px; padding: 6px 14px; font-size: 0.84em; cursor: pointer;">Cancel</button>
      <button type="button" id="md-graphviz-block-save-btn" style="background: #0284c7; border: 1px solid #38bdf8; color: #ffffff; border-radius: 4px; padding: 6px 16px; font-size: 0.84em; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;"><i class="fas fa-save"></i> Save Global Block</button>
    </div>
  </div>
</div>
