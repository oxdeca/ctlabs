          <div id="md-graphviz-new-template-desc" style="margin-top: 6px; font-size: 0.78em; color: #94a3b8; line-height: 1.4; background: rgba(15, 23, 42, 0.5); padding: 6px 10px; border-radius: 4px; border: 1px solid #334155; min-height: 40px; box-sizing: border-box;">
            Default starter with 3 basic nodes.
          </div>
        </div>

        <div>
          <label for="md-graphviz-new-theme-select" style="display: block; font-size: 0.85em; font-weight: 600; color: #cbd5e1; margin-bottom: 6px;">
