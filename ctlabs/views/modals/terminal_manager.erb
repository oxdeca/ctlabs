<div id="terminal-manager-modal" class="w3-modal" style="z-index: 9999;">
  <div class="w3-modal-content w3-round-large w3-card-4" style="background-color: #1e293b; color: #f8fafc; max-width: 500px;">
    <header class="w3-container w3-padding" style="border-bottom: 1px solid #334155;">
      <span onclick="document.getElementById('terminal-manager-modal').style.display='none'" class="w3-button w3-display-topright w3-round-large">&times;</span>
      <h4 id="term-mgr-title" style="margin: 0; color: #38bdf8;"><i class="fas fa-terminal"></i> Terminal Sessions</h4>
    </header>
    <div class="w3-container w3-padding">
      <p id="term-mgr-msg" style="margin-bottom: 20px; color: #cbd5e1;"></p>
      <div id="term-mgr-actions" style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 10px;">
        <button id="btn-open-new" class="w3-button w3-blue w3-block" onclick="window.confirmTerminalAction('open')">
          <i class="fas fa-plus-circle"></i> Open New Session
        </button>
        <button id="btn-terminate-oldest" class="w3-button w3-red w3-block" onclick="window.confirmTerminalAction('terminate')">
          <i class="fas fa-trash-alt"></i> Terminate Oldest & Open New
        </button>
        <button class="w3-button w3-block" style="background-color: #475569; color: white;" onclick="document.getElementById('terminal-manager-modal').style.display='none'">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>
