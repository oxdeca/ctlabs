<div id="ssh-agent-modal" class="w3-modal" style="z-index: 9999;">
  <div class="w3-modal-content w3-round-large w3-card-4" style="background-color: #1e293b; color: #f8fafc; max-width: 650px;">
    
    <header class="w3-container w3-padding" style="border-bottom: 1px solid #334155; background-color: #0f172a; border-radius: 12px 12px 0 0; display:flex; justify-content:space-between; align-items:center;">
      <div>
        <h4 style="margin: 0; font-size: 1.15rem; font-weight: 600;">
          <i class="fas fa-key w3-text-teal" style="margin-right: 8px;"></i>SSH Agent Manager
          <span id="ssh-agent-target-badge" class="w3-badge w3-small w3-round w3-indigo" style="margin-left: 8px; font-size: 11px; padding: 2px 8px; vertical-align: middle;">ctl-ctrl</span>
        </h4>
      </div>
      <span onclick="document.getElementById('ssh-agent-modal').style.display='none'" class="w3-button w3-hover-red w3-round" style="color: #cbd5e1; font-size: 1.2rem; padding: 2px 10px;">&times;</span>
    </header>

    <div class="w3-container w3-padding" style="max-height: 75vh; overflow-y: auto;">
      
      <!-- Alert feedback box -->
      <div id="ssh-agent-alert" class="w3-panel w3-round" style="display: none; padding: 10px 14px; margin-bottom: 14px; font-size: 13px;"></div>

      <!-- Loaded Keys Section -->
      <div class="w3-margin-bottom">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 8px;">
          <label style="font-size: 0.85em; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
            <i class="fas fa-shield-alt w3-text-teal"></i> Active Identities in Agent
          </label>
          <button type="button" id="ssh-agent-clear-btn" onclick="window.clearSshAgentKeys()" class="w3-button w3-round w3-hover-red" style="display: none; background-color: #334155; color: #f87171; padding: 2px 8px; font-size: 11px;">
            <i class="fas fa-trash-alt"></i> Clear All Keys
          </button>
        </div>

        <div id="ssh-agent-identities-container" class="w3-round" style="background-color: #0f172a; border: 1px solid #334155; padding: 10px; min-height: 60px;">
          <div id="ssh-agent-loading-identities" style="color: #94a3b8; text-align: center; padding: 12px; font-size: 13px;">
            <i class="fas fa-spinner fa-spin"></i> Checking agent status...
          </div>
          <div id="ssh-agent-empty-msg" style="display: none; color: #64748b; text-align: center; padding: 12px; font-size: 13px;">
            <i class="fas fa-info-circle"></i> No private keys currently loaded in agent.
          </div>
          <table id="ssh-agent-identities-table" class="w3-table w3-small" style="display: none; width: 100%;">
            <thead>
              <tr style="border-bottom: 1px solid #334155; color: #94a3b8;">
                <th style="padding: 4px 6px;">Type</th>
                <th style="padding: 4px 6px;">Fingerprint</th>
                <th style="padding: 4px 6px;">Comment / ID</th>
              </tr>
            </thead>
            <tbody id="ssh-agent-identities-tbody"></tbody>
          </table>
        </div>
      </div>

      <!-- Add Key Form -->
      <div class="w3-margin-top" style="border-top: 1px solid #334155; padding-top: 14px;">
        <label style="font-size: 0.85em; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 10px;">
          <i class="fas fa-plus-circle w3-text-green"></i> Load Key into Agent
        </label>

        <form id="ssh-agent-add-form" onsubmit="event.preventDefault(); window.submitSshAgentAddKey(event);">
          <div class="w3-margin-bottom">
            <label style="font-size: 0.85em; color: #94a3b8;">Private Key Path (in container)</label>
            <input type="text" id="ssh-agent-key-path" list="ssh-agent-candidate-keys" placeholder="e.g. ~/.ssh/keys/git_oanda or /root/.ssh/id_ed25519" class="w3-input w3-small w3-round" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569; font-family: monospace;" required>
            <datalist id="ssh-agent-candidate-keys"></datalist>
          </div>

          <div class="w3-margin-bottom">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 2px;">
              <label style="font-size: 0.85em; color: #94a3b8;">Passphrase (leave blank if unencrypted)</label>
              <a href="javascript:void(0)" onclick="window.toggleSshAgentPassVisibility()" style="font-size: 11px; color: #38bdf8; text-decoration: none;">
                <i id="ssh-agent-pass-icon" class="fas fa-eye"></i> Show
              </a>
            </div>
            <input type="password" id="ssh-agent-passphrase" placeholder="Key Passphrase" class="w3-input w3-small w3-round" style="background-color: #0f172a; color: #e2e8f0; border: 1px solid #475569; font-family: monospace;">
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px;">
            <button type="submit" id="ssh-agent-submit-btn" class="w3-button w3-round w3-teal" style="font-size: 13px; font-weight: 600; padding: 6px 14px;">
              <i class="fas fa-unlock-alt"></i> Add Key to Agent
            </button>
          </div>
        </form>
      </div>

      <!-- Info note -->
      <div class="w3-margin-top" style="border-top: 1px solid #334155; padding-top: 12px; color: #64748b; font-size: 12px; line-height: 1.4;">
        <i class="fas fa-lightbulb w3-text-yellow" style="margin-right: 4px;"></i>
        <strong>Terminal Tip:</strong> You can also load keys directly in the Web Terminal using standard OpenSSH commands:
        <code style="background-color: #0f172a; padding: 2px 6px; color: #38bdf8; border-radius: 4px;">ssh-add ~/.ssh/keys/git_oanda</code>.
      </div>

    </div>
  </div>
</div>
