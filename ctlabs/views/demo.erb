            <input type="text" id="export-filename" name="filename" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #475569; color: #f8fafc; padding: 8px 12px; border-radius: 4px; font-size: 0.9em;" placeholder="walkthrough.zip" required />
