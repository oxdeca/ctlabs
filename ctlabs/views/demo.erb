            <button type="button" id="image-modal-zoom-fit" title="Fit to screen (F)" style="height: 26px; padding: 0 10px; border-radius: 13px; border: 1px solid #475569; background: rgba(15, 23, 42, 0.7); color: #cbd5e1; cursor: pointer; font-size: 0.75em; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s ease;">Fit</button>
