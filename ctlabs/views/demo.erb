                    </button>
                    <button type="button" class="md-snippet-item" data-snippet="callout_tip" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; background: transparent; border: none; color: #f8fafc; font-size: 0.83em; text-align: left; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-lightbulb" style="color: #10b981; width: 14px; text-align: center;"></i>
                        <span>Tip</span>
                      </span>
                      <code style="font-size: 0.76em; color: #94a3b8; background: rgba(255,255,255,0.06); padding: 1px 4px; border-radius: 3px;">&gt; [!TIP]</code>
                    </button>
                    <button type="button" class="md-snippet-item" data-snippet="callout_important" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; background: transparent; border: none; color: #f8fafc; font-size: 0.83em; text-align: left; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-exclamation-circle" style="color: #a855f7; width: 14px; text-align: center;"></i>
                        <span>Important</span>
                      </span>
                      <code style="font-size: 0.76em; color: #94a3b8; background: rgba(255,255,255,0.06); padding: 1px 4px; border-radius: 3px;">&gt; [!IMPORTANT]</code>
                    </button>
                    <button type="button" class="md-snippet-item" data-snippet="callout_warning" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; background: transparent; border: none; color: #f8fafc; font-size: 0.83em; text-align: left; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-exclamation-triangle" style="color: #f59e0b; width: 14px; text-align: center;"></i>
                        <span>Warning</span>
                      </span>
                      <code style="font-size: 0.76em; color: #94a3b8; background: rgba(255,255,255,0.06); padding: 1px 4px; border-radius: 3px;">&gt; [!WARNING]</code>
                    </button>
                    <button type="button" class="md-snippet-item" data-snippet="callout_caution" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; background: transparent; border: none; color: #f8fafc; font-size: 0.83em; text-align: left; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-fire" style="color: #ef4444; width: 14px; text-align: center;"></i>
                        <span>Caution</span>
                      </span>
                      <code style="font-size: 0.76em; color: #94a3b8; background: rgba(255,255,255,0.06); padding: 1px 4px; border-radius: 3px;">&gt; [!CAUTION]</code>
                    </button>

                    <div style="height: 1px; background: #334155; margin: 4px 0;"></div>
                    <div style="padding: 3px 12px 1px; font-size: 0.68em; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.5px;">Blocks &amp; Formatting</div>
                    <button type="button" class="md-snippet-item" data-snippet="code_block" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; background: transparent; border: none; color: #f8fafc; font-size: 0.83em; text-align: left; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-terminal" style="color: #f59e0b; width: 14px; text-align: center;"></i>
                        <span>Code Block</span>
                      </span>
                      <code style="font-size: 0.76em; color: #94a3b8; background: rgba(255,255,255,0.06); padding: 1px 4px; border-radius: 3px;">```bash</code>
                    </button>
                    <button type="button" class="md-snippet-item" data-snippet="task_list" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; background: transparent; border: none; color: #f8fafc; font-size: 0.83em; text-align: left; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-check-square" style="color: #a855f7; width: 14px; text-align: center;"></i>
                        <span>Task Checklist</span>
                      </span>
                      <code style="font-size: 0.76em; color: #94a3b8; background: rgba(255,255,255,0.06); padding: 1px 4px; border-radius: 3px;">- [ ] task</code>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Right Side: Save, Git, Settings (in edit mode) -->
              <div style="display: flex; align-items: center; gap: 6px;">
                <button type="button" id="md-tab-split" style="display: none;"></button>

                <!-- Note Save Button (Disk) -->
                <button type="button" id="md-save-btn" title="Save note to disk (Ctrl+S)" style="display: none; padding: 3px 9px; font-size: 0.82em; border-radius: 4px; border: 1px solid #475569; background: #1e293b; color: #cbd5e1; cursor: pointer; align-items: center; gap: 5px; height: 26px; transition: all 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='#1e293b'">
                  <i class="fas fa-save" style="color: #38bdf8; font-size: 0.9em;"></i>
                  <span id="md-save-btn-text" style="font-weight: 500;">Save</span>
                </button>

                <!-- Note Git Actions Dropdown (Commit & History) -->
                <div id="md-git-wrapper" style="position: relative; display: none;">
                  <button type="button" id="md-git-btn" title="Git repository actions (Commit, History)" style="padding: 3px 9px; font-size: 0.82em; border-radius: 4px; border: 1px solid #475569; background: #1e293b; color: #cbd5e1; cursor: pointer; display: inline-flex; align-items: center; gap: 5px; height: 26px; transition: background 0.15s, border-color 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='#1e293b'">
                    <i class="fas fa-code-branch" style="color: #10b981; font-size: 0.9em;"></i>
                    <span style="font-weight: 500;">Git</span>
                    <i class="fas fa-caret-down" style="font-size: 0.75em; opacity: 0.7; margin-left: 1px;"></i>
                  </button>
                  <div id="md-git-menu" style="display: none; position: absolute; top: calc(100% + 6px); right: 0; min-width: 210px; background: #1e293b; border: 1px solid #475569; border-radius: 6px; box-shadow: 0 10px 25px rgba(0,0,0,0.6); z-index: 1000; overflow: hidden; padding: 4px 0;">
                    <button type="button" id="md-git-commit-btn" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: transparent; border: none; color: #f8fafc; font-size: 0.84em; text-align: left; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-code-branch" style="color: #10b981; width: 14px; text-align: center;"></i> Commit note
                      </span>
                      <span style="font-size: 0.75em; color: #64748b; font-family: ui-monospace, monospace;">^⇧C</span>
                    </button>
                    <button type="button" id="md-git-history-btn" style="width: 100%; display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: transparent; border: none; color: #f8fafc; font-size: 0.84em; text-align: left; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <i class="fas fa-history" style="color: #38bdf8; width: 14px; text-align: center;"></i> Version history &amp; diffs
                    </button>
                  </div>
                </div>

                <!-- Markdown Editor Settings Dropdown -->
                <div id="md-settings-wrapper" style="position: relative; display: none;">
                  <button type="button" id="md-settings-btn" title="Editor settings (Wrap Code, options)" style="padding: 3px 9px; font-size: 0.82em; border-radius: 4px; border: 1px solid #475569; background: #1e293b; color: #cbd5e1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; height: 26px; transition: background 0.15s, border-color 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='#1e293b'">
                    <i class="fas fa-cog" style="color: #94a3b8;"></i>
                  </button>
                  <div id="md-settings-menu" style="display: none; position: absolute; top: calc(100% + 6px); right: 0; min-width: 230px; background: #1e293b; border: 1px solid #475569; border-radius: 6px; box-shadow: 0 10px 25px rgba(0,0,0,0.6); z-index: 1000; overflow: hidden; padding: 4px 0;">
                    <div style="padding: 6px 12px; font-size: 0.72em; text-transform: uppercase; color: #94a3b8; font-weight: 700; letter-spacing: 0.5px; border-bottom: 1px solid #334155; margin-bottom: 4px;">
                      Editor Settings
                    </div>
                    <label id="md-setting-split-label" style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; cursor: pointer; color: #f8fafc; font-size: 0.84em; user-select: none; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-columns" style="color: #38bdf8; width: 14px; text-align: center;"></i> Split editor mode
                      </span>
                      <input type="checkbox" id="md-setting-split-checkbox" style="cursor: pointer; accent-color: #38bdf8; width: 15px; height: 15px;" />
                    </label>
                    <label id="md-setting-wrap-label" style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; cursor: pointer; color: #f8fafc; font-size: 0.84em; user-select: none; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-align-left" style="color: #38bdf8; width: 14px; text-align: center;"></i> Wrap code blocks
                      </span>
                      <input type="checkbox" id="md-setting-wrap-checkbox" style="cursor: pointer; accent-color: #38bdf8; width: 15px; height: 15px;" />
                    </label>
                    <label id="md-setting-vim-label" style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; cursor: pointer; color: #f8fafc; font-size: 0.84em; user-select: none; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-terminal" style="color: #22c55e; width: 14px; text-align: center;"></i> Vi / Vim keybindings
                      </span>
                      <input type="checkbox" id="md-setting-vim-checkbox" style="cursor: pointer; accent-color: #22c55e; width: 15px; height: 15px;" />
                    </label>
                    <div style="padding: 8px 12px; border-top: 1px solid #334155; margin-top: 4px;">
                      <div style="font-size: 0.82em; color: #cbd5e1; margin-bottom: 5px; display: flex; align-items: center; gap: 6px;">
                        <i class="fas fa-clock" style="color: #38bdf8; width: 14px; text-align: center;"></i> Auto-save interval
                      </div>
                      <select id="md-setting-autosave-select" style="width: 100%; background: #0f172a; color: #f8fafc; border: 1px solid #475569; border-radius: 4px; padding: 4px 6px; font-size: 0.82em; outline: none; cursor: pointer;">
                        <option value="0" selected>Off (Manual save only)</option>
                        <option value="2000">2 seconds (Fast)</option>
                        <option value="5000">5 seconds</option>
                        <option value="15000">15 seconds</option>
                        <option value="30000">30 seconds</option>
                        <option value="60000">1 minute</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div id="md-content-area" style="flex: 1; min-height: 0; display: flex; overflow: hidden;">
              <!-- Edit Pane -->
              <div id="md-edit-pane" style="flex: 1; min-width: 0; display: none; flex-direction: column; height: 100%; border-right: none;">
                <div style="flex: 1; min-height: 0; position: relative;">
                  <textarea id="md-textarea" placeholder="# Enter Markdown text here..." spellcheck="false" style="width: 100%; height: 100%; resize: none; background: #090d16; color: #f1f5f9; border: none; padding: 16px; font-family: ui-monospace, monospace !important; font-size: 0.8em; line-height: 1.6; outline: none; box-sizing: border-box;"></textarea>
                </div>
                <!-- Markdown Editor Bottom Status Bar -->
                <div id="md-status-bar" style="display: flex; padding: 4px 12px; background: #0f172a; border-top: 1px solid #334155; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.74em; color: #94a3b8; align-items: center; justify-content: space-between; user-select: none; min-height: 25px; box-sizing: border-box; flex-shrink: 0;">
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <div id="md-vim-status-bar" style="display: none; align-items: center; gap: 8px;">
                      <span id="md-vim-status-mode" style="font-weight: 700; color: #38bdf8; letter-spacing: 0.5px;">-- NORMAL --</span>
                      <span id="md-vim-status-key" style="color: #cbd5e1;"></span>
                    </div>
                    <span id="md-save-status" style="display: none; align-items: center; font-weight: 500;"></span>
                  </div>
                  <div style="display: flex; align-items: center; gap: 12px; color: #64748b; font-size: 0.9em;">
                    <span id="md-vim-hints" style="display: none;">:w save &bull; Esc normal mode</span>
                    <span id="md-editor-cursor-pos" style="color: #94a3b8;">Ln 1, Col 1</span>
                  </div>
                </div>
              </div>
              <!-- Middle Resizer Bar (Split Mode) -->
              <div id="md-splitter" title="Drag left/right to resize panes (double-click to reset 50/50)" style="display: none; width: 8px; background: #0b1120; border-left: 1px solid #334155; border-right: 1px solid #334155; cursor: col-resize; flex: none; align-items: center; justify-content: center; user-select: none; touch-action: none; transition: background 0.15s ease, border-color 0.15s ease; z-index: 10;">
                <div class="v-grip-handle" style="width: 2px; height: 32px; background: #64748b; border-radius: 2px; transition: background 0.15s; pointer-events: none;"></div>
              </div>
              <!-- Preview Pane -->
              <div id="md-preview-pane" class="markdown-body" style="flex: 1; min-width: 0; height: 100%; overflow-y: auto; padding: 24px 32px; color: #e2e8f0; line-height: 1.65; box-sizing: border-box;">
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <!-- Delete Walkthrough Set Modal -->
    <div id="delete-set-modal" class="w3-modal" style="z-index: 9999;">
      <div class="w3-modal-content w3-round-large w3-card-4" style="background-color: #1e293b; color: #f8fafc; max-width: 480px;">
        <header class="w3-container" style="background-color: #0f172a; border-top-left-radius: 8px; border-top-right-radius: 8px; padding: 12px 16px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center;">
          <h3 style="margin: 0; font-size: 1.1em; font-weight: 600; color: #ef4444;"><i class="fas fa-trash-alt"></i> Delete Walkthrough Set</h3>
          <span onclick="document.getElementById('delete-set-modal').style.display='none'" class="w3-button w3-display-topright w3-hover-red" style="cursor: pointer; background: transparent; color: #94a3b8; font-size: 1.2em; padding: 10px 16px; border-top-right-radius: 8px;">&times;</span>
        </header>
        <form method="post" action="/walkthroughs/<%= ERB::Util.url_encode(@active_walkthrough.to_s) %>/delete" style="padding: 16px; margin: 0;">
          <p style="color: #cbd5e1; font-size: 0.9em; margin-top: 0; margin-bottom: 12px; line-height: 1.5;">
            Are you sure you want to delete the walkthrough set <strong>&ldquo;<%= ERB::Util.html_escape(@walkthrough_name.to_s) %>&rdquo;</strong>?
          </p>
          <div style="background: #0f172a; padding: 12px; border-radius: 6px; border: 1px solid #334155; margin-bottom: 16px;">
            <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer; color: #f8fafc; font-size: 0.85em; user-select: none;">
              <input type="checkbox" name="delete_recordings" value="1" style="margin-top: 2px; accent-color: #ef4444;" />
              <span>
                <strong>Also delete recordings from disk</strong>
                <span style="display: block; color: #94a3b8; font-size: 0.85em; margin-top: 2px;">
                  Permanently deletes .cast recording files belonging to this set. Recordings shared with other sets will be preserved.
                </span>
              </span>
            </label>
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 8px;">
            <button type="button" onclick="document.getElementById('delete-set-modal').style.display='none'" class="w3-button w3-round" style="background: #475569; color: #f8fafc; font-size: 0.85em; padding: 6px 14px;">Cancel</button>
            <button type="submit" class="w3-button w3-round w3-red" style="font-size: 0.85em; padding: 6px 14px; font-weight: 600;"><i class="fas fa-trash-alt"></i> Delete Set</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Picture Inspector Modal -->
    <div id="pic-inspector-modal" class="w3-modal" style="z-index: 9999;">
      <div class="w3-modal-content w3-round-large w3-card-4" style="background-color: #1e293b; color: #f8fafc; max-width: 880px;">
        <header class="w3-container" style="background-color: #0f172a; border-top-left-radius: 8px; border-top-right-radius: 8px; padding: 12px 16px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center;">
          <h3 style="margin: 0; font-size: 1.1em; font-weight: 600; color: #38bdf8; display: flex; align-items: center; gap: 8px;"><i class="fas fa-images"></i> Picture Inspector</h3>
          <span onclick="document.getElementById('pic-inspector-modal').style.display='none'" class="w3-button w3-display-topright w3-hover-red" style="cursor: pointer; background: transparent; color: #94a3b8; font-size: 1.2em; padding: 10px 16px; border-top-right-radius: 8px;">&times;</span>
        </header>
        <div style="padding: 14px 16px;">
          <!-- Controls bar: Section Filter Tabs & Multi-select actions -->
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
            <!-- Tabs: Unused, Used, All -->
            <div id="pic-inspector-tabs" style="display: inline-flex; background: #0f172a; border: 1px solid #334155; border-radius: 6px; padding: 2px;">
              <button type="button" class="pic-inspector-tab-btn" data-tab="all" style="background: #0284c7; color: #ffffff; border: none; border-radius: 4px; padding: 5px 12px; font-size: 0.82em; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s;">
                <i class="fas fa-layer-group"></i> All <span id="pic-tab-count-all" style="background: rgba(0,0,0,0.3); padding: 1px 6px; border-radius: 10px; font-size: 0.9em;">0</span>
              </button>
              <button type="button" class="pic-inspector-tab-btn" data-tab="unused" style="background: transparent; color: #94a3b8; border: none; border-radius: 4px; padding: 5px 12px; font-size: 0.82em; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s;">
                <i class="fas fa-trash-alt" style="color: #f59e0b;"></i> Unused <span id="pic-tab-count-unused" style="background: rgba(0,0,0,0.3); padding: 1px 6px; border-radius: 10px; font-size: 0.9em;">0</span>
              </button>
              <button type="button" class="pic-inspector-tab-btn" data-tab="used" style="background: transparent; color: #94a3b8; border: none; border-radius: 4px; padding: 5px 12px; font-size: 0.82em; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s;">
                <i class="fas fa-check-circle" style="color: #10b981;"></i> Used <span id="pic-tab-count-used" style="background: rgba(0,0,0,0.3); padding: 1px 6px; border-radius: 10px; font-size: 0.9em;">0</span>
              </button>
            </div>
            <!-- Multi-select actions -->
            <div id="pic-inspector-batch-actions" style="display: flex; align-items: center; gap: 10px;">
              <label id="pic-inspector-select-all-wrap" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.82em; color: #cbd5e1; cursor: pointer; user-select: none;">
                <input type="checkbox" id="pic-inspector-select-all" style="cursor: pointer; width: 15px; height: 15px; accent-color: #ef4444;" />
                <span>Select all</span>
              </label>
