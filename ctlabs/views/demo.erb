        let mdWrapCode = false;
        try {
          mdWrapCode = localStorage.getItem('ctlabs_md_wrap_code') === 'true';
        } catch (e) {}

        let mdVimMode = false;
        try {
          mdVimMode = localStorage.getItem('ctlabs_md_vim_mode') === 'true';
