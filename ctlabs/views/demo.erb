                    <button type="button" class="md-snippet-item" data-snippet="callout_note" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; background: transparent; border: none; color: #f8fafc; font-size: 0.83em; text-align: left; cursor: pointer; transition: background 0.15s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='transparent'">
                      <span style="display: flex; align-items: center; gap: 8px;">
                        <i class="fas fa-info-circle" style="color: #38bdf8; width: 14px; text-align: center;"></i>
                        <span>Note / Info</span>
                      </span>
