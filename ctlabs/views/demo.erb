      <!-- Image Display Container / Stage -->
      <div id="image-modal-stage" style="position: relative; width: 100%; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; touch-action: none; user-select: none; cursor: grab;">
        <img id="image-modal-img" src="" alt="" draggable="false" style="display: block; position: absolute; left: 0; top: 0; transform-origin: 0 0; max-width: none; max-height: none; user-select: none; -webkit-user-drag: none; will-change: transform; border-radius: 6px; box-shadow: 0 10px 35px rgba(0, 0, 0, 0.8); border: 1px solid #334155; background: #0b1120;" />
      </div>

      <!-- Caption -->
      <div id="image-modal-caption" style="margin-top: 10px; color: #cbd5e1; font-size: 0.9em; font-weight: 500; text-align: center; max-width: 80vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,0.8); flex: none; z-index: 10001; pointer-events: none;"></div>
