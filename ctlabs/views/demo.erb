          <button type="button" id="image-modal-annotate" title="Annotate / Edit Screenshot" style="display: flex; color: #10b981; background: rgba(30, 41, 59, 0.85); border: 1px solid #475569; width: 36px; height: 36px; border-radius: 50%; align-items: center; justify-content: center; font-size: 0.9em; cursor: pointer; transition: all 0.15s ease;">
            <i class="fas fa-paint-brush"></i>
          </button>
          <button type="button" id="image-modal-edit-diagram" title="Edit Graphviz Diagram" style="display: none; color: #38bdf8; background: rgba(30, 41, 59, 0.85); border: 1px solid #475569; width: 36px; height: 36px; border-radius: 50%; align-items: center; justify-content: center; font-size: 0.9em; cursor: pointer; transition: all 0.15s ease;">
            <i class="fas fa-project-diagram"></i>
          </button>
          <a id="image-modal-external" href="#" target="_blank" title="Open original in new tab" style="color: #cbd5e1; background: rgba(30, 41, 59, 0.85); border: 1px solid #475569; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: all 0.15s ease;">
