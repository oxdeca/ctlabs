                      <span id="video-tl-sel-lane-num" style="font-family: monospace; font-weight: 700; color: #f1f5f9; font-size: 0.82em; min-width: 14px; text-align: center; padding: 0 1px;">1</span>
                      <button type="button" id="video-tl-lane-up-btn" title="Move to lower lane" style="background: transparent; border: none; color: #cbd5e1; cursor: pointer; padding: 0 4px; height: 18px; font-size: 0.75em; display: flex; align-items: center;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#cbd5e1'">+</button>
