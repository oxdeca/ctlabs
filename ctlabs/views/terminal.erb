<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Terminal: <%= @node_name %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body, html {
      margin:      0; padding: 0; height: 100%;
      background:  #0f172a; color: #f8fafc;
      font-family: sans-serif; overflow: hidden;
      display:     flex; flex-direction: column;
    }
    #header {
      background:    #1e293b; 
      padding:       4px 12px;
      border-bottom: 1px solid #334155;
      display:       flex; justify-content: space-between; align-items: center;
      flex-shrink:   0; font-size: 0.85em;
    }
    .status { color: #10b981; font-size: 0.85em; }
    .status.disconnected { color: #ef4444; }
    
    /* --- UNIFIED SLIM SCROLLBARS --- */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; border: 2px solid #0f172a; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }
    
    .xterm-viewport { scrollbar-width: thin; scrollbar-color: #334155 #0f172a; }
    
    #terminal-container {
      width: 100%; flex: 1; min-height: 0;
      padding: 0; box-sizing: border-box; overflow: hidden;
    }
    .xterm { height: 100%; padding: 0; }
  </style>
</head>
<body data-node-name="<%= ERB::Util.html_escape(@node_name) %>">
  
  <div id="header">
    <strong><i class="fas fa-terminal"></i> <%= @node_name %></strong>
    <span id="status" class="status"><i class="fas fa-circle"></i> Connecting...</span>
  </div>
  <div id="terminal-container"></div>

  <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('terminal-container');
      const headerEl = document.getElementById('header');
      const nodeName = document.body.dataset.nodeName;

      const initialCols = 120;
      const initialRows = 40;

      const term = new Terminal({
        cols: initialCols,
        rows: initialRows,
        lineHeight: 1,
        theme: { background: '#300a24', foreground: '#ffffff', cursor: '#ffffff', selectionBackground: 'rgba(56, 189, 248, 0.3)' },
        fontFamily: '"Courier New", Courier, monospace',
        cursorBlink: true, fontSize: 14
      });

      term.onSelectionChange(() => {
          const selection = term.getSelection();
          if (selection) navigator.clipboard.writeText(selection);
      });

      const fitAddon = new FitAddon.FitAddon();
      term.loadAddon(fitAddon);
      term.open(container);

      const cellSize = () => {
        const d = term._core && term._core._renderService && term._core._renderService.dimensions;
        if (d && d.css && d.css.cell) return d.css.cell;
        if (d && d.actualCellHeight) return { width: d.actualCellWidth, height: d.actualCellHeight };
        return null;
      };

      // Browser chrome (title bar + borders) so resizeTo() can target the exact
      // INNER size that matches the cell grid.
      const chromeW = window.outerWidth - window.innerWidth;
      const chromeH = window.outerHeight - window.innerHeight;
      // xterm renders its own overlay scrollbar; fit() subtracts scrollBarWidth
      // from the available width, so the window must reserve it to end up with
      // the full intended column count.
      const scrollBarWidth = term._core && term._core.viewport ? term._core.viewport.scrollBarWidth : 0;

      // fit() floors rows/cols, so the usable height always ends on a partial
      // cell and the last text row floats above a variable band of background
      // (the "sometimes there's an extra row" the user sees).
      //
      // Fix: resize the popup window ONCE to the exact inner size that holds
      // the full 120x40 grid, then fit once more to adopt it. resizeTo is only
      // ever called here — the resize listener below re-fits but never resizes
//      the window, so a resizeTo -> fit -> resizeTo feedback loop
      //      (which also shrank the window column-by-column via the scrollbar offset)
      //      is impossible.
      const pinToGrid = () => {
        const cell = cellSize();
        if (!cell || !window.resizeTo) return;
        fitAddon.fit();
        window.resizeTo(
          Math.round(initialCols * cell.width + scrollBarWidth) + chromeW,
          Math.round(initialRows * cell.height + headerEl.offsetHeight) + chromeH
        );
        fitAddon.fit();
      };

      const openSocket = () => {
        const protocol = window.location.protocol === 'https:' ? 'wss://' : 'ws://';
        const wsUrl = protocol + window.location.host + '/terminal/' + encodeURIComponent(nodeName) +
                      `?cols=${term.cols}&rows=${term.rows}`;
        const ws = new WebSocket(wsUrl);
        const statusEl = document.getElementById('status');

        ws.onopen = () => {
          statusEl.innerHTML = '<i class="fas fa-circle"></i> Connected';
          term.focus();
          // Re-confirm size after onopen; PTY was already spawned at correct size
          ws.send(JSON.stringify({ type: 'resize', cols: term.cols, rows: term.rows }));
        };

        ws.onmessage = (event) => term.write(event.data);

        ws.onclose = () => {
          statusEl.innerHTML = '<i class="fas fa-times-circle"></i> Disconnected';
          statusEl.classList.add('disconnected');
          term.write('\r\n\x1b[31m[Connection closed]\x1b[0m\r\n');
        };

        term.onData(data => {
          if (ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ type: 'input', data: data }));
        });

        term.onResize(size => {
          if (ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ type: 'resize', cols: size.cols, rows: size.rows }));
        });

        // Re-fit if the user drags the window or changes zoom. Fit-only:
        // never resizeTo here, so synthetically sized windows can't feed back
        // into a resize loop or shrink cascade.
        window.addEventListener('resize', () => fitAddon.fit());
      };

      const start = () => {
        // Pin the popup to the full 120x40 grid exactly once.
        pinToGrid();
        // Second pass after the window resize settles, so the WS opens with
        // the exact post-pin cols/rows.
        requestAnimationFrame(() => {
          fitAddon.fit();
          openSocket();
        });
      };

      // Don't measure the grid until the font is actually loaded, or the
      // cell size (and thus the snapped window) could be computed from a
      // fallback font and shift everything once Courier New arrives.
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(start).catch(() => start());
      } else {
        start();
      }
    });
  </script>
</body>
</html>
