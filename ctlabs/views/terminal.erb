        function showTermSshAlert(msg, type) {
          if (!termSshAlert) return;
          termSshAlert.style.display = 'block';
          if (type === 'success') {
            termSshAlert.style.background = '#064e3b';
            termSshAlert.style.color = '#6ee7b7';
            termSshAlert.style.border = '1px solid #059669';
            termSshAlert.innerHTML = '<i class="fas fa-check-circle"></i> ' + escapeHtml(msg);
          } else {
            termSshAlert.style.background = '#7f1d1d';
            termSshAlert.style.color = '#fca5a5';
            termSshAlert.style.border = '1px solid #dc2626';
            termSshAlert.innerHTML = '<i class="fas fa-exclamation-triangle"></i> ' + escapeHtml(msg);
          }
        }

        async function loadTermSshAgentStatus() {
          const statusInd = document.getElementById('term-ssh-status-indicator');
          const countEl = document.getElementById('term-ssh-key-count');
          const summaryEl = document.getElementById('term-ssh-quick-summary');
          const badgeEl = document.getElementById('settings-tab-ssh-badge');

          const modalLoading = document.getElementById('term-ssh-loading-identities');
          const modalEmpty = document.getElementById('term-ssh-empty-msg');
          const modalTable = document.getElementById('term-ssh-identities-table');
          const modalTbody = document.getElementById('term-ssh-identities-tbody');
          const candidateDatalist = document.getElementById('term-ssh-candidate-keys');

          if (modalLoading) modalLoading.style.display = 'block';
          if (modalEmpty) modalEmpty.style.display = 'none';
          if (modalTable) modalTable.style.display = 'none';
          if (termSshModalClearBtn) termSshModalClearBtn.style.display = 'none';

          try {
            const res = await fetch('/terminal/' + encodeURIComponent(nodeName) + '/ssh_agent?t=' + Date.now(), {
              credentials: 'same-origin'
            });
            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.error || ('HTTP ' + res.status));
            }
            const data = await res.json();
            const identities = Array.isArray(data.identities) ? data.identities : [];
            const count = identities.length;

            if (modalLoading) modalLoading.style.display = 'none';

            if (statusInd) {
              statusInd.innerHTML = '<i class="fas fa-circle" style="font-size: 0.65em;"></i> <span>Running</span>';
              statusInd.style.color = '#10b981';
            }
            if (countEl) {
              countEl.textContent = count + (count === 1 ? ' key' : ' keys');
            }
            if (badgeEl) {
              if (count > 0) {
                badgeEl.textContent = count;
                badgeEl.style.display = 'inline-block';
              } else {
                badgeEl.style.display = 'none';
              }
            }
            if (termSshClearBtn) {
              termSshClearBtn.style.display = count > 0 ? 'inline-flex' : 'none';
            }
            if (summaryEl) {
              if (count > 0) {
                const names = identities.map(id => id.comment || id.type || 'key').join(', ');
                summaryEl.innerHTML = `<span style="color: #14b8a6;"><i class="fas fa-key"></i></span> ${escapeHtml(names)}`;
                summaryEl.style.display = 'block';
              } else {
                summaryEl.style.display = 'none';
              }
            }

            if (modalTbody) {
              modalTbody.innerHTML = '';
              identities.forEach(id => {
                const tr = document.createElement('tr');
                tr.style.borderBottom = '1px solid #334155';
                tr.innerHTML = `
                  <td style="padding: 6px;"><span style="background: #334155; color: #cbd5e1; font-family: monospace; font-size: 0.75em; padding: 2px 5px; border-radius: 3px;">${escapeHtml(id.type || 'RSA')}</span></td>
                  <td style="padding: 6px;"><code style="color: #38bdf8; font-size: 0.85em;">${escapeHtml(id.fingerprint || '')}</code></td>
                  <td style="padding: 6px; color: #e2e8f0; font-family: monospace;">${escapeHtml(id.comment || id.raw || '')}</td>
                `;
                modalTbody.appendChild(tr);
              });
            }
            if (count > 0) {
              if (modalTable) modalTable.style.display = 'table';
              if (termSshModalClearBtn) termSshModalClearBtn.style.display = 'inline-block';
            } else {
              if (modalEmpty) modalEmpty.style.display = 'block';
            }

            if (candidateDatalist && Array.isArray(data.candidate_keys)) {
              candidateDatalist.innerHTML = data.candidate_keys.map(k => `<option value="${escapeHtml(k)}"></option>`).join('');
              if (termSshKeyPath && !termSshKeyPath.value && data.candidate_keys.length > 0) {
                termSshKeyPath.value = data.candidate_keys[0];
              }
            }
          } catch (err) {
            if (modalLoading) modalLoading.style.display = 'none';
            if (statusInd) {
              statusInd.innerHTML = '<i class="fas fa-circle" style="font-size: 0.65em;"></i> <span>Error</span>';
              statusInd.style.color = '#ef4444';
            }
            if (countEl) countEl.textContent = 'Unavailable';
          }
        }

        async function clearTermSshAgentKeys() {
          if (!confirm('Clear all in-memory keys from the SSH Agent?')) return;
          try {
            const res = await fetch('/terminal/' + encodeURIComponent(nodeName) + '/ssh_agent/clear', {
              method: 'POST',
              credentials: 'same-origin'
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Failed to clear keys');
            showTermSshAlert('All SSH keys cleared from agent.', 'success');
            loadTermSshAgentStatus();
          } catch (err) {
            showTermSshAlert('Error clearing keys: ' + err.message, 'error');
          }
        }

        function switchTermSshMode(mode) {
          termSshAgentMode = mode;
          if (mode === 'local') {
            if (termSshModeLocalBtn) termSshModeLocalBtn.classList.add('active');
            if (termSshModeRemoteBtn) termSshModeRemoteBtn.classList.remove('active');
            if (termSshPaneLocal) termSshPaneLocal.style.display = 'block';
            if (termSshPaneRemote) termSshPaneRemote.style.display = 'none';
          } else {
            if (termSshModeLocalBtn) termSshModeLocalBtn.classList.remove('active');
            if (termSshModeRemoteBtn) termSshModeRemoteBtn.classList.add('active');
            if (termSshPaneLocal) termSshPaneLocal.style.display = 'none';
            if (termSshPaneRemote) termSshPaneRemote.style.display = 'block';
          }
        }

        function openTermSshModal() {
          if (settingsMenu) settingsMenu.style.display = 'none';
          if (termSshAlert) {
            termSshAlert.style.display = 'none';
            termSshAlert.innerHTML = '';
          }
          if (termSshModalBackdrop) termSshModalBackdrop.style.display = 'flex';
          switchTermSshMode('local');
          loadTermSshAgentStatus();
        }

        function closeTermSshModal() {
          if (termSshModalBackdrop) termSshModalBackdrop.style.display = 'none';
        }

        if (termSshManageBtn) termSshManageBtn.addEventListener('click', openTermSshModal);
        if (termSshClearBtn) termSshClearBtn.addEventListener('click', clearTermSshAgentKeys);
        if (termSshModalClearBtn) termSshModalClearBtn.addEventListener('click', clearTermSshAgentKeys);
        if (termSshModalClose) termSshModalClose.addEventListener('click', closeTermSshModal);
        if (termSshModalCancel) termSshModalCancel.addEventListener('click', closeTermSshModal);
        if (termSshModalBackdrop) {
          termSshModalBackdrop.addEventListener('click', (e) => {
            if (e.target === termSshModalBackdrop) closeTermSshModal();
          });
        }

        if (termSshModeLocalBtn) termSshModeLocalBtn.addEventListener('click', () => switchTermSshMode('local'));
        if (termSshModeRemoteBtn) termSshModeRemoteBtn.addEventListener('click', () => switchTermSshMode('remote'));

        function handleTermSshKeyFile(file) {
          if (!file) return;
          const reader = new FileReader();
          reader.onload = (e) => {
            uploadedTermSshKeyContent = e.target.result;
            if (termSshSelectedFileLabel) {
              termSshSelectedFileLabel.textContent = file.name + ' (' + formatBytes(file.size) + ')';
              termSshSelectedFileLabel.style.display = 'inline-block';
            }
            if (termSshKeyName && !termSshKeyName.value) {
              termSshKeyName.value = file.name;
            }
            if (termSshPasteBox) termSshPasteBox.style.display = 'none';
            if (termSshPasteContent) termSshPasteContent.value = '';
          };
          reader.readAsText(file);
        }

        if (termSshDropzone && termSshFilePicker) {
          termSshDropzone.addEventListener('click', () => termSshFilePicker.click());
          termSshFilePicker.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) handleTermSshKeyFile(e.target.files[0]);
          });
          termSshDropzone.addEventListener('dragover', (e) => {
            e.preventDefault();
            termSshDropzone.style.borderColor = '#14b8a6';
            termSshDropzone.style.backgroundColor = '#132338';
          });
          termSshDropzone.addEventListener('dragleave', (e) => {
            e.preventDefault();
            termSshDropzone.style.borderColor = '#475569';
            termSshDropzone.style.backgroundColor = '#0b1120';
          });
          termSshDropzone.addEventListener('drop', (e) => {
            e.preventDefault();
            termSshDropzone.style.borderColor = '#475569';
            termSshDropzone.style.backgroundColor = '#0b1120';
            if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
              handleTermSshKeyFile(e.dataTransfer.files[0]);
            }
          });
        }

        if (termSshPasteToggleLink && termSshPasteBox) {
          termSshPasteToggleLink.addEventListener('click', () => {
            const isHidden = termSshPasteBox.style.display === 'none';
            termSshPasteBox.style.display = isHidden ? 'block' : 'none';
            termSshPasteToggleLink.innerHTML = isHidden
              ? '<i class="fas fa-times"></i> Hide paste box'
              : '<i class="fas fa-keyboard"></i> Or paste key text directly';
            if (isHidden && termSshPasteContent) termSshPasteContent.focus();
          });
        }

        if (termSshPassToggleLink && termSshPassphrase) {
          termSshPassToggleLink.addEventListener('click', () => {
            const isPass = termSshPassphrase.type === 'password';
            termSshPassphrase.type = isPass ? 'text' : 'password';
            termSshPassToggleLink.innerHTML = isPass
              ? '<i class="fas fa-eye-slash"></i> Hide'
              : '<i class="fas fa-eye"></i> Show';
          });
        }

        if (termSshAddForm) {
          termSshAddForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (termSshAlert) termSshAlert.style.display = 'none';

            let payload = {};
            const passphrase = termSshPassphrase ? termSshPassphrase.value : '';

            if (termSshAgentMode === 'local') {
              const pasteVal = termSshPasteContent ? termSshPasteContent.value : '';
              const keyContent = uploadedTermSshKeyContent || pasteVal;
              const keyName = termSshKeyName ? termSshKeyName.value.trim() : '';
              const saveToDisk = termSshSaveDisk ? termSshSaveDisk.checked : true;

              if (!keyContent || !keyContent.trim()) {
                showTermSshAlert('Please choose a private key file or paste private key content.', 'error');
                return;
              }

              payload = {
                key_content: keyContent,
                key_name: keyName,
                passphrase: passphrase,
                save_to_disk: saveToDisk
              };
            } else {
              const keyPath = termSshKeyPath ? termSshKeyPath.value.trim() : '';
              if (!keyPath) {
                showTermSshAlert('Please enter the container key path.', 'error');
                return;
              }
              payload = {
                key_path: keyPath,
                passphrase: passphrase
              };
            }

            if (termSshSubmitBtn) {
              termSshSubmitBtn.disabled = true;
              termSshSubmitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading key...';
            }

            try {
              const res = await fetch('/terminal/' + encodeURIComponent(nodeName) + '/ssh_agent/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
                credentials: 'same-origin'
              });
              const data = await res.json();
              if (!res.ok || !data.success) {
                throw new Error(data.error || ('HTTP ' + res.status));
              }

              showTermSshAlert(data.message || 'Key successfully loaded into SSH Agent!', 'success');
              if (termSshPassphrase) termSshPassphrase.value = '';
              if (termSshFilePicker) termSshFilePicker.value = '';
              uploadedTermSshKeyContent = '';
              if (termSshSelectedFileLabel) termSshSelectedFileLabel.style.display = 'none';
              if (termSshPasteContent) termSshPasteContent.value = '';

              await loadTermSshAgentStatus();
            } catch (err) {
              showTermSshAlert('Failed to load key: ' + err.message, 'error');
            } finally {
              if (termSshSubmitBtn) {
                termSshSubmitBtn.disabled = false;
                termSshSubmitBtn.innerHTML = '<i class="fas fa-unlock-alt"></i> Load Key into Agent';
              }
            }
          });
        }

        // Initial check of agent status
        loadTermSshAgentStatus();
        window.loadTermSshAgentStatus = loadTermSshAgentStatus;
      }

      // =========================================================================
