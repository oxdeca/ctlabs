        newFiles.forEach(item => {
          if (!stagedUploadFiles.some(existing => existing.relPath === item.relPath)) {
            stagedUploadFiles.push(item);
          }
        });

        newDirs.forEach(dir => {
          if (!stagedUploadDirs.includes(dir)) {
            stagedUploadDirs.push(dir);
          }
        });

        renderUploadPreview();
      }

      function renderUploadPreview() {
        if (!uploadFilePreview) return;

        const totalItems = stagedUploadFiles.length + stagedUploadDirs.length;
