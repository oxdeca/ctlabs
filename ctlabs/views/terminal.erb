      const termToastIcon = document.getElementById('term-toast-icon');
      const termToastMsg = document.getElementById('term-toast-msg');

      let stagedUploadFiles = [];
      let stagedUploadDirs = [];
      let isUploading = false;
      let activeTransferTab = 'upload';
      let nodeTargetInfo = { default_dir: '/root' };
      let currentBrowsedDir = '~';
      let toastTimer = null;
      let dragCounter = 0;

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function resetUploadSubmitButton(customLabel = null) {
        if (!uploadSubmitBtn) return;
        const hasItems = stagedUploadFiles.length > 0 || stagedUploadDirs.length > 0;
        uploadSubmitBtn.disabled = !hasItems || isUploading;
        uploadSubmitBtn.style.opacity = (hasItems && !isUploading) ? '1' : '0.6';
        uploadSubmitBtn.style.cursor = (hasItems && !isUploading) ? 'pointer' : 'not-allowed';
        const labelText = customLabel || (stagedUploadFiles.length > 1 ? `Upload ${stagedUploadFiles.length} Files` : 'Upload File');
        uploadSubmitBtn.innerHTML = `<i class="fas fa-upload"></i> <span>${escapeHtml(labelText)}</span>`;
      }

      function showToast(msg, type = 'info', duration = 3000) {
        if (!termToast || !termToastMsg) return;
        termToastMsg.textContent = msg;
        if (type === 'success') {
          termToastIcon.className = 'fas fa-check-circle';
          termToastIcon.style.color = '#10b981';
        } else if (type === 'error') {
          termToastIcon.className = 'fas fa-exclamation-circle';
          termToastIcon.style.color = '#ef4444';
        } else {
          termToastIcon.className = 'fas fa-info-circle';
          termToastIcon.style.color = '#38bdf8';
        }
        termToast.style.display = 'flex';
        termToast.style.opacity = '1';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          termToast.style.opacity = '0';
          setTimeout(() => { termToast.style.display = 'none'; }, 300);
        }, duration);
      }

      function showUploadFeedback(msg, type = 'info') {
        if (!uploadFeedback) return;
        uploadFeedback.style.display = 'block';
        if (type === 'success') {
          uploadFeedback.style.background = '#064e3b';
          uploadFeedback.style.color = '#a7f3d0';
        } else if (type === 'error') {
          uploadFeedback.style.background = '#7f1d1d';
          uploadFeedback.style.color = '#fecaca';
        } else {
          uploadFeedback.style.background = '#1e3a8a';
          uploadFeedback.style.color = '#bfdbfe';
        }
        uploadFeedback.innerHTML = msg;
      }

      function showDownloadFeedback(msg, type = 'info') {
        if (!downloadFeedback) return;
        downloadFeedback.style.display = 'block';
        if (type === 'success') {
          downloadFeedback.style.background = '#064e3b';
          downloadFeedback.style.color = '#a7f3d0';
        } else if (type === 'error') {
          downloadFeedback.style.background = '#7f1d1d';
          downloadFeedback.style.color = '#fecaca';
        } else {
          downloadFeedback.style.background = '#1e3a8a';
          downloadFeedback.style.color = '#bfdbfe';
        }
        downloadFeedback.innerHTML = msg;
      }

      function switchTransferTab(tab) {
        activeTransferTab = tab;
        if (tab === 'upload') {
          tabBtnUpload.classList.add('active');
          tabBtnDownload.classList.remove('active');
          tabBtnUpload.style.background = '#1e293b';
          tabBtnUpload.style.borderBottom = '2px solid #38bdf8';
          tabBtnUpload.style.color = '#f8fafc';
          tabBtnUpload.style.fontWeight = '600';
          tabBtnDownload.style.background = 'transparent';
          tabBtnDownload.style.borderBottom = '2px solid transparent';
          tabBtnDownload.style.color = '#94a3b8';
          tabBtnDownload.style.fontWeight = '500';

          paneUpload.style.display = 'block';
          paneDownload.style.display = 'none';
          uploadSubmitBtn.style.display = 'flex';
          downloadSubmitBtn.style.display = 'none';
        } else {
          tabBtnDownload.classList.add('active');
          tabBtnUpload.classList.remove('active');
          tabBtnDownload.style.background = '#1e293b';
          tabBtnDownload.style.borderBottom = '2px solid #38bdf8';
          tabBtnDownload.style.color = '#f8fafc';
          tabBtnDownload.style.fontWeight = '600';
          tabBtnUpload.style.background = 'transparent';
          tabBtnUpload.style.borderBottom = '2px solid transparent';
          tabBtnUpload.style.color = '#94a3b8';
          tabBtnUpload.style.fontWeight = '500';

          paneUpload.style.display = 'none';
          paneDownload.style.display = 'block';
          uploadSubmitBtn.style.display = 'none';
          downloadSubmitBtn.style.display = 'flex';

          const currentPath = (downloadPathInput && downloadPathInput.value.trim()) || (nodeTargetInfo && nodeTargetInfo.default_dir) || '~';
          fetchNodeFileList(currentPath);
        }
      }

      function openFilesModal(tab = 'upload') {
        switchTransferTab(tab);
        if (uploadFeedback) uploadFeedback.style.display = 'none';
        if (downloadFeedback) downloadFeedback.style.display = 'none';
        if (!isUploading) resetUploadSubmitButton();
        if (filesModalBackdrop) filesModalBackdrop.style.display = 'flex';
      }

      function closeFilesModal() {
        if (filesModalBackdrop) filesModalBackdrop.style.display = 'none';
        if (uploadFeedback) uploadFeedback.style.display = 'none';
        if (downloadFeedback) downloadFeedback.style.display = 'none';
      }

      async function getFilesFromDataTransfer(dataTransfer) {
        const files = [];
        const emptyDirs = [];
        if (!dataTransfer) return { files, emptyDirs };

        const items = dataTransfer.items;
        if (items && items.length > 0 && (items[0].webkitGetAsEntry || items[0].getAsEntry)) {
          const queue = [];
          for (let i = 0; i < items.length; i++) {
            const entry = items[i].webkitGetAsEntry ? items[i].webkitGetAsEntry() : (items[i].getAsEntry ? items[i].getAsEntry() : null);
            if (entry) queue.push({ entry, path: '' });
          }

          while (queue.length > 0) {
            const { entry, path } = queue.shift();
            if (entry.isFile) {
              const file = await new Promise((resolve, reject) => entry.file(resolve, reject));
              const relPath = path ? `${path}/${file.name}` : file.name;
              files.push({ file, relPath });
            } else if (entry.isDirectory) {
              const dirPath = path ? `${path}/${entry.name}` : entry.name;
              const dirReader = entry.createReader();
              let dirEntries = [];
              let batch;
              do {
                batch = await new Promise((resolve, reject) => dirReader.readEntries(resolve, reject));
                if (batch && batch.length > 0) {
                  dirEntries.push(...batch);
                }
              } while (batch && batch.length > 0);

              if (dirEntries.length === 0) {
                emptyDirs.push(dirPath);
              } else {
                for (const child of dirEntries) {
                  queue.push({ entry: child, path: dirPath });
                }
              }
            }
          }
          return { files, emptyDirs };
        }

        if (dataTransfer.files && dataTransfer.files.length > 0) {
          for (let i = 0; i < dataTransfer.files.length; i++) {
            const file = dataTransfer.files[i];
            const relPath = file.webkitRelativePath || file.name;
            files.push({ file, relPath });
          }
        }
        return { files, emptyDirs };
      }

      function stageUploadItems(newFiles, newDirs = [], append = false) {
        if (!append) {
          stagedUploadFiles = [];
          stagedUploadDirs = [];
        }

        newFiles.forEach(item => {
          if (!stagedUploadFiles.some(existing => existing.relPath === item.relPath)) {
            stagedUploadFiles.push(item);
          }
        });

        newDirs.forEach(dir => {
          if (!stagedUploadDirs.includes(dir)) {
            stagedUploadDirs.push(dir);
          }
        });

        renderUploadPreview();
      }

      function renderUploadPreview() {
        if (!uploadFilePreview) return;

        const totalItems = stagedUploadFiles.length + stagedUploadDirs.length;
        if (totalItems === 0) {
          clearSelectedUploadFile();
          return;
        }

        const totalBytes = stagedUploadFiles.reduce((acc, item) => acc + item.file.size, 0);

        if (stagedUploadFiles.length === 1 && stagedUploadDirs.length === 0 && !stagedUploadFiles[0].relPath.includes('/')) {
          const item = stagedUploadFiles[0];
          if (uploadPreviewIcon) {
            uploadPreviewIcon.className = 'fas fa-file-alt';
            uploadPreviewIcon.style.color = '#38bdf8';
          }
          if (uploadPreviewName) uploadPreviewName.textContent = item.file.name;
          if (uploadPreviewDetails) uploadPreviewDetails.textContent = formatBytes(item.file.size);
          if (uploadToggleListBtn) uploadToggleListBtn.style.display = 'none';
          if (uploadItemsList) uploadItemsList.style.display = 'none';
          if (uploadCustomLabel) uploadCustomLabel.textContent = 'Rename on Node (Optional):';
          if (uploadCustomName) uploadCustomName.placeholder = 'Leave empty to keep original filename';
          resetUploadSubmitButton('Upload File');
        } else {
          const allPaths = stagedUploadFiles.map(f => f.relPath).concat(stagedUploadDirs);
          const firstRoot = allPaths[0] ? allPaths[0].split('/')[0] : '';
          const hasCommonRoot = allPaths.length > 0 && allPaths.every(p => p.startsWith(firstRoot + '/') || p === firstRoot);

          if (uploadPreviewIcon) {
            uploadPreviewIcon.className = hasCommonRoot ? 'fas fa-folder-open' : 'fas fa-layer-group';
            uploadPreviewIcon.style.color = '#f59e0b';
          }
          if (uploadPreviewName) uploadPreviewName.textContent = hasCommonRoot ? firstRoot : `${totalItems} items selected`;
          if (uploadPreviewDetails) {
            uploadPreviewDetails.textContent = `${stagedUploadFiles.length} file${stagedUploadFiles.length === 1 ? '' : 's'}${stagedUploadDirs.length > 0 ? `, ${stagedUploadDirs.length} empty dir${stagedUploadDirs.length === 1 ? '' : 's'}` : ''} • Total: ${formatBytes(totalBytes)}`;
          }

          if (uploadToggleListBtn) uploadToggleListBtn.style.display = 'inline-flex';
          if (uploadCustomLabel) uploadCustomLabel.textContent = 'Subfolder on Node (Optional):';
          if (uploadCustomName) uploadCustomName.placeholder = 'e.g. my-folder (places files inside this folder)';
          resetUploadSubmitButton(`Upload ${stagedUploadFiles.length} File${stagedUploadFiles.length === 1 ? '' : 's'}`);

          if (uploadItemsList) {
            uploadItemsList.innerHTML = '';
            stagedUploadFiles.forEach((item, idx) => {
              const row = document.createElement('div');
              row.style.cssText = 'display: flex; align-items: center; justify-content: space-between; padding: 3px 6px; border-radius: 3px; background: rgba(255,255,255,0.03);';
              row.innerHTML = `
                <div style="display: flex; align-items: center; gap: 6px; overflow: hidden; min-width: 0;">
                  <i class="fas fa-file-alt" style="color: #94a3b8; font-size: 0.85em;"></i>
                  <span style="color: #cbd5e1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escapeHtml(item.relPath)}">${escapeHtml(item.relPath)}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                  <span style="color: #64748b; font-size: 0.85em;">${formatBytes(item.file.size)}</span>
                  <button type="button" style="background: transparent; border: none; color: #ef4444; cursor: pointer; padding: 0 2px; font-size: 1.1em; line-height: 1;" title="Remove this file">&times;</button>
                </div>
              `;
              const rmBtn = row.querySelector('button');
              rmBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                stagedUploadFiles.splice(idx, 1);
                renderUploadPreview();
              });
              uploadItemsList.appendChild(row);
            });

            stagedUploadDirs.forEach((dir, idx) => {
              const row = document.createElement('div');
              row.style.cssText = 'display: flex; align-items: center; justify-content: space-between; padding: 3px 6px; border-radius: 3px; background: rgba(255,255,255,0.03);';
              row.innerHTML = `
                <div style="display: flex; align-items: center; gap: 6px; overflow: hidden; min-width: 0;">
                  <i class="fas fa-folder" style="color: #f59e0b; font-size: 0.85em;"></i>
                  <span style="color: #cbd5e1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${escapeHtml(dir)}/">${escapeHtml(dir)}/ (empty dir)</span>
                </div>
                <button type="button" style="background: transparent; border: none; color: #ef4444; cursor: pointer; padding: 0 2px; font-size: 1.1em; line-height: 1;" title="Remove this directory">&times;</button>
              `;
              const rmBtn = row.querySelector('button');
              rmBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                stagedUploadDirs.splice(idx, 1);
                renderUploadPreview();
              });
              uploadItemsList.appendChild(row);
            });
          }
        }

        uploadFilePreview.style.display = 'flex';
        if (uploadFeedback) uploadFeedback.style.display = 'none';
        if (uploadProgressContainer) uploadProgressContainer.style.display = 'none';
      }

      function clearSelectedUploadFile() {
        stagedUploadFiles = [];
        stagedUploadDirs = [];
        if (uploadFileInput) uploadFileInput.value = '';
        if (uploadFolderInput) uploadFolderInput.value = '';
        if (uploadPreviewName) uploadPreviewName.textContent = '';
        if (uploadPreviewDetails) uploadPreviewDetails.textContent = '';
        if (uploadFilePreview) uploadFilePreview.style.display = 'none';
        if (uploadItemsList) {
          uploadItemsList.innerHTML = '';
          uploadItemsList.style.display = 'none';
        }
        if (uploadToggleListBtn) {
          uploadToggleListBtn.style.display = 'none';
          uploadToggleListBtn.innerHTML = '<i class="fas fa-list"></i> Details';
        }
        if (uploadCustomName) uploadCustomName.value = '';
        if (uploadCustomLabel) uploadCustomLabel.textContent = 'Rename on Node (Optional):';
        if (uploadProgressContainer) uploadProgressContainer.style.display = 'none';
        resetUploadSubmitButton('Upload File');
      }

      // Populate shortcuts
      function setupDirectoryShortcuts(defaultDir) {
        const uploadDirs = ['~/.ssh', '~', '/tmp', '/root'];
        if (defaultDir && !uploadDirs.includes(defaultDir)) {
          uploadDirs.unshift(defaultDir);
        }

        const downloadDirs = ['~', '~/.ssh', '/tmp', '/root'];
        if (defaultDir && !downloadDirs.includes(defaultDir)) {
          downloadDirs.unshift(defaultDir);
        }

        if (uploadDirShortcuts) {
          uploadDirShortcuts.innerHTML = '<span style="color: #64748b; font-size: 0.75em; margin-right: 2px;">Quick dirs:</span>';
          uploadDirs.forEach(d => {
            const pill = document.createElement('span');
            pill.className = 'dir-pill';
            pill.textContent = d;
            pill.title = `Use ${d} as destination`;
            pill.addEventListener('click', () => {
              uploadDirInput.value = d;
            });
            uploadDirShortcuts.appendChild(pill);
          });
        }

        if (downloadPathShortcuts) {
          downloadPathShortcuts.innerHTML = '<span style="color: #64748b; font-size: 0.75em; margin-right: 2px;">Quick paths:</span>';
          downloadDirs.forEach(d => {
            const pill = document.createElement('span');
            pill.className = 'dir-pill';
            pill.textContent = d;
            pill.title = `Browse & inspect ${d}`;
            pill.addEventListener('click', () => {
              downloadPathInput.value = d;
              inspectRemotePath(d);
              fetchNodeFileList(d);
            });
            downloadPathShortcuts.appendChild(pill);
          });
        }
      }

      // Fetch node target info to set default paths and shortcuts
      fetch('/terminal/' + encodeURIComponent(nodeName) + '/target_info', { credentials: 'same-origin' })
        .then(res => res.json())
        .then(data => {
          if (data.ok) {
            nodeTargetInfo = data;
            if (uploadDirInput && !uploadDirInput.value) {
              uploadDirInput.value = data.default_dir || '~';
            }
            if (termDropDestHint) {
              termDropDestHint.textContent = `Destination: ${data.default_dir || '~'}`;
            }
            setupDirectoryShortcuts(data.default_dir);
          }
        })
        .catch(() => {
          setupDirectoryShortcuts('/root');
        });

      // Files buttons (Upload / Download) and modal open/close
      if (uploadBtn) uploadBtn.addEventListener('click', () => openFilesModal('upload'));
      if (downloadBtn) downloadBtn.addEventListener('click', () => openFilesModal('download'));
      if (filesBtn) filesBtn.addEventListener('click', () => openFilesModal('upload'));
      if (filesModalClose) filesModalClose.addEventListener('click', closeFilesModal);
      if (filesModalCancel) filesModalCancel.addEventListener('click', closeFilesModal);
      if (filesModalBackdrop) {
        filesModalBackdrop.addEventListener('click', (e) => {
          if (e.target === filesModalBackdrop) closeFilesModal();
        });
      }

      // Tab switching
      if (tabBtnUpload) tabBtnUpload.addEventListener('click', () => switchTransferTab('upload'));
      if (tabBtnDownload) tabBtnDownload.addEventListener('click', () => switchTransferTab('download'));

      // Dropzone, browse buttons, and file picking
      if (uploadBrowseFilesBtn && uploadFileInput) {
        uploadBrowseFilesBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          uploadFileInput.click();
        });
      }

      if (uploadBrowseFolderBtn && uploadFolderInput) {
        uploadBrowseFolderBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          uploadFolderInput.click();
        });
      }

      if (uploadToggleListBtn && uploadItemsList) {
        uploadToggleListBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isHidden = uploadItemsList.style.display === 'none';
          uploadItemsList.style.display = isHidden ? 'flex' : 'none';
          uploadToggleListBtn.innerHTML = isHidden ? '<i class="fas fa-chevron-up"></i> Hide' : '<i class="fas fa-list"></i> Details';
        });
      }

      if (uploadFileInput) {
        uploadFileInput.addEventListener('change', () => {
          if (uploadFileInput.files && uploadFileInput.files.length > 0) {
            const files = Array.from(uploadFileInput.files).map(f => ({ file: f, relPath: f.name }));
            stageUploadItems(files, [], false);
          }
        });
      }

      if (uploadFolderInput) {
        uploadFolderInput.addEventListener('change', () => {
          if (uploadFolderInput.files && uploadFolderInput.files.length > 0) {
            const files = Array.from(uploadFolderInput.files).map(f => ({
              file: f,
              relPath: f.webkitRelativePath || f.name
            }));
            stageUploadItems(files, [], false);
          }
        });
      }

      if (uploadDropzone) {
        uploadDropzone.addEventListener('click', (e) => {
          if (e.target.closest('button')) return;
          if (uploadFileInput) uploadFileInput.click();
        });

        uploadDropzone.addEventListener('dragover', (e) => {
          e.preventDefault();
          uploadDropzone.classList.add('dragover');
        });
        uploadDropzone.addEventListener('dragleave', (e) => {
          e.preventDefault();
          uploadDropzone.classList.remove('dragover');
        });
        uploadDropzone.addEventListener('drop', async (e) => {
          e.preventDefault();
          uploadDropzone.classList.remove('dragover');
          if (e.dataTransfer) {
            const { files, emptyDirs } = await getFilesFromDataTransfer(e.dataTransfer);
            if (files.length > 0 || emptyDirs.length > 0) {
              stageUploadItems(files, emptyDirs, false);
            }
          }
        });
      }

      if (uploadFileClear) {
        uploadFileClear.addEventListener('click', clearSelectedUploadFile);
      }

      // Batch upload function using XMLHttpRequest for upload progress tracking
      function uploadBatchXhr(nodeName, batchFiles, destDir, batchDirs = [], onProgress) {
        return new Promise((resolve, reject) => {
          const xhr = new XMLHttpRequest();
          const formData = new FormData();
          if (destDir) formData.append('dest_dir', destDir);

          batchDirs.forEach(d => formData.append('dirs[]', d));
          batchFiles.forEach(item => {
            formData.append('files[]', item.file, item.file.name);
            formData.append('paths[]', item.relPath);
          });

          if (xhr.upload && onProgress) {
            xhr.upload.onprogress = (e) => {
              if (e.lengthComputable) onProgress(e.loaded, e.total);
            };
          }

          xhr.onload = () => {
            if ((xhr.status >= 200 && xhr.status < 300) || xhr.status === 207) {
              try {
                const data = JSON.parse(xhr.responseText);
                resolve(data);
              } catch (err) {
                reject(new Error('Invalid response from server'));
              }
            } else {
              try {
                const data = JSON.parse(xhr.responseText);
                reject(new Error(data.error || `HTTP ${xhr.status}`));
              } catch {
                reject(new Error(`Upload failed with HTTP status ${xhr.status}`));
              }
            }
          };

          xhr.onerror = () => reject(new Error('Network error during upload'));
          xhr.open('POST', '/terminal/' + encodeURIComponent(nodeName) + '/upload');
          xhr.send(formData);
        });
      }

      // Upload submit
      if (uploadSubmitBtn) {
        uploadSubmitBtn.addEventListener('click', async () => {
          if (isUploading) return;
          if (stagedUploadFiles.length === 0 && stagedUploadDirs.length === 0) return;
          isUploading = true;
          const destDir = (uploadDirInput.value || '').trim();
          const customName = (uploadCustomName.value || '').trim();

          uploadSubmitBtn.disabled = true;
          uploadSubmitBtn.style.opacity = '0.7';
          uploadSubmitBtn.style.cursor = 'wait';
          uploadSubmitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Uploading...</span>';
          showUploadFeedback('<i class="fas fa-spinner fa-spin"></i> Uploading to node...', 'info');

          if (uploadProgressContainer) {
            uploadProgressContainer.style.display = 'block';
            uploadProgressBar.style.width = '0%';
            uploadProgressPercent.textContent = '0%';
            uploadProgressBytes.textContent = 'Preparing...';
            uploadProgressBatch.textContent = '';
          }

          // Compute effective relative paths and directories if customName is provided
          let effectiveFiles = [];
          let effectiveDirs = [];

          if (stagedUploadFiles.length === 1 && stagedUploadDirs.length === 0 && !stagedUploadFiles[0].relPath.includes('/')) {
            const single = stagedUploadFiles[0];
            effectiveFiles = [{
              file: single.file,
              relPath: customName || single.relPath
            }];
          } else {
            effectiveFiles = stagedUploadFiles.map(item => ({
              file: item.file,
              relPath: customName ? `${customName}/${item.relPath}` : item.relPath
            }));
            effectiveDirs = stagedUploadDirs.map(d => (customName ? `${customName}/${d}` : d));
            if (customName && effectiveDirs.length === 0 && effectiveFiles.length === 0) {
              effectiveDirs.push(customName);
            }
          }

          const grandTotalBytes = effectiveFiles.reduce((acc, f) => acc + f.file.size, 0);
          let completedBytes = 0;
          let totalUploadedCount = 0;
          let uploadErrors = [];

          const BATCH_SIZE = 40;
          const totalBatches = Math.max(1, Math.ceil(effectiveFiles.length / BATCH_SIZE));

          try {
            for (let b = 0; b < totalBatches; b++) {
              const startIdx = b * BATCH_SIZE;
              const batchFiles = effectiveFiles.slice(startIdx, startIdx + BATCH_SIZE);
              const batchDirs = (b === 0) ? effectiveDirs : [];
              const batchBytes = batchFiles.reduce((acc, f) => acc + f.file.size, 0);

              if (uploadProgressBatch) {
                uploadProgressBatch.textContent = `Batch ${b + 1} of ${totalBatches}`;
              }

              const res = await uploadBatchXhr(
                nodeName,
                batchFiles,
                destDir,
                batchDirs,
                (loadedBytes) => {
                  const currentBytes = Math.min(completedBytes + loadedBytes, grandTotalBytes);
                  const pct = grandTotalBytes > 0 ? Math.round((currentBytes / grandTotalBytes) * 100) : 100;
                  if (uploadProgressBar) uploadProgressBar.style.width = pct + '%';
                  if (uploadProgressPercent) uploadProgressPercent.textContent = pct + '%';
                  if (uploadProgressBytes) uploadProgressBytes.textContent = `${formatBytes(currentBytes)} / ${formatBytes(grandTotalBytes)}`;
                }
              );

              completedBytes += batchBytes;
              totalUploadedCount += (res.count || batchFiles.length);
              if (res.errors && res.errors.length > 0) {
                uploadErrors.push(...res.errors);
              }
            }

            if (uploadErrors.length === 0) {
              if (uploadProgressBar) uploadProgressBar.style.width = '100%';
              if (uploadProgressPercent) uploadProgressPercent.textContent = '100%';
              if (uploadProgressBytes) uploadProgressBytes.textContent = `${formatBytes(grandTotalBytes)} / ${formatBytes(grandTotalBytes)}`;

              const msg = `Successfully uploaded <strong>${totalUploadedCount} item${totalUploadedCount === 1 ? '' : 's'}</strong> (${formatBytes(grandTotalBytes)}) to <code>${escapeHtml(destDir || (nodeTargetInfo && nodeTargetInfo.default_dir) || '~')}</code>`;
              showUploadFeedback(`<i class="fas fa-check-circle" style="color: #10b981; margin-right: 4px;"></i> ${msg}`, 'success');
              showToast(`Uploaded ${totalUploadedCount} item${totalUploadedCount === 1 ? '' : 's'} (${formatBytes(grandTotalBytes)})`, 'success');
              clearSelectedUploadFile();
              fetchNodeFileList(destDir || (nodeTargetInfo && nodeTargetInfo.default_dir) || '~');
            } else {
              const errSummary = uploadErrors.map(e => `${escapeHtml(e.filename)}: ${escapeHtml(e.error)}`).join('<br>');
              showUploadFeedback(`<i class="fas fa-exclamation-triangle" style="margin-right: 4px;"></i> Upload completed with errors:<br>${errSummary}`, 'error');
            }
          } catch (err) {
            showUploadFeedback(`<i class="fas fa-exclamation-triangle" style="margin-right: 4px;"></i> ${escapeHtml(err.message || 'Upload failed')}`, 'error');
          } finally {
            isUploading = false;
            resetUploadSubmitButton();
          }
        });
      }

      // Download Inspect & Download logic
      async function inspectRemotePath(path) {
        const queryPath = (path || '').trim();
        if (!queryPath) {
          if (downloadInspectContent) {
            downloadInspectContent.innerHTML = '<span style="color: #64748b; font-style: italic;">Enter a path and click "Check" or "Download". Directories will be archived as <code>.tar.gz</code>.</span>';
          }
          return null;
        }

        if (downloadInspectContent) {
          downloadInspectContent.innerHTML = '<span style="color: #38bdf8;"><i class="fas fa-spinner fa-spin"></i> Checking path...</span>';
        }

        try {
          const res = await fetch('/terminal/' + encodeURIComponent(nodeName) + '/check_file?path=' + encodeURIComponent(queryPath), {
            credentials: 'same-origin'
          });
          const info = await res.json();
          renderInspectResult(info);
          return info;
        } catch (err) {
          if (downloadInspectContent) {
            downloadInspectContent.innerHTML = `<span style="color: #ef4444;"><i class="fas fa-exclamation-circle"></i> Error checking path: ${escapeHtml(err.message)}</span>`;
          }
          return null;
        }
      }

      function renderInspectResult(info) {
        if (!downloadInspectContent) return;
        if (!info || !info.ok || !info.exists) {
          downloadInspectContent.innerHTML = `
            <div style="display: flex; align-items: center; gap: 8px; color: #ef4444;">
              <i class="fas fa-times-circle" style="font-size: 1.1em;"></i>
              <div>
                <span style="font-weight: 500;">Not found</span>
                <span style="color: #94a3b8; font-size: 0.85em; margin-left: 6px;"><code>${escapeHtml(info ? info.path : downloadPathInput.value)}</code></span>
              </div>
            </div>
          `;
          return;
        }

        if (info.type === 'file') {
          downloadInspectContent.innerHTML = `
            <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-file-alt" style="color: #38bdf8; font-size: 1.3em;"></i>
                <div>
                  <div style="color: #f8fafc; font-weight: 600; font-family: monospace;">${escapeHtml(info.name)}</div>
                  <div style="color: #94a3b8; font-size: 0.85em;">Regular File &bull; ${formatBytes(info.size)} &bull; <code>${escapeHtml(info.path)}</code></div>
                </div>
              </div>
              <span style="background: #1e3a8a; color: #93c5fd; padding: 3px 8px; border-radius: 4px; font-size: 0.8em; font-weight: 600;">Ready</span>
            </div>
          `;
        } else if (info.type === 'dir') {
          downloadInspectContent.innerHTML = `
            <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-folder" style="color: #f59e0b; font-size: 1.3em;"></i>
                <div>
                  <div style="color: #f8fafc; font-weight: 600; font-family: monospace;">${escapeHtml(info.name)}/</div>
                  <div style="color: #94a3b8; font-size: 0.85em;">Directory &bull; Will download as <code>${escapeHtml(info.name)}.tar.gz</code> archive</div>
                </div>
              </div>
              <span style="background: #854d0e; color: #fef08a; padding: 3px 8px; border-radius: 4px; font-size: 0.8em; font-weight: 600;">Archive</span>
            </div>
          `;
        }
      }

      if (downloadInspectBtn) {
        downloadInspectBtn.addEventListener('click', () => {
          inspectRemotePath(downloadPathInput.value);
        });
      }

      if (downloadPathInput) {
        downloadPathInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            inspectRemotePath(downloadPathInput.value);
          }
        });
      }

      if (downloadSubmitBtn) {
        downloadSubmitBtn.addEventListener('click', async () => {
          const path = (downloadPathInput.value || '').trim();
          if (!path) {
            showDownloadFeedback('Please enter a file or directory path to download', 'error');
            return;
          }

          showDownloadFeedback('<i class="fas fa-spinner fa-spin"></i> Checking path before download...', 'info');
          downloadSubmitBtn.disabled = true;
          downloadSubmitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Preparing...</span>';

          try {
            const info = await inspectRemotePath(path);
            if (!info || !info.exists) {
              showDownloadFeedback(`<i class="fas fa-exclamation-triangle"></i> Path not found on node: <code>${escapeHtml(path)}</code>`, 'error');
              return;
            }

            const downloadFilename = info.type === 'dir' ? `${info.name}.tar.gz` : info.name;
            showDownloadFeedback(`<i class="fas fa-check-circle" style="color: #10b981;"></i> Starting download of <strong>${escapeHtml(downloadFilename)}</strong>...`, 'success');
            showToast(`Downloading ${downloadFilename}...`, 'info');

            // Trigger browser download via location
            window.location.href = '/terminal/' + encodeURIComponent(nodeName) + '/download?path=' + encodeURIComponent(path);
          } catch (err) {
            showDownloadFeedback(`<i class="fas fa-exclamation-triangle"></i> ${escapeHtml(err.message || 'Download error')}`, 'error');
          } finally {
            downloadSubmitBtn.disabled = false;
            downloadSubmitBtn.innerHTML = '<i class="fas fa-download"></i> <span>Download</span>';
          }
        });
      }

      // Fetch and render files/directories for node file browser in Download tab
      async function fetchNodeFileList(dir) {
        if (!downloadFilesContainer) return;
        const targetDir = (dir || currentBrowsedDir || (nodeTargetInfo && nodeTargetInfo.default_dir) || '~').trim();
        currentBrowsedDir = targetDir;
        if (downloadBrowseDir) {
          downloadBrowseDir.textContent = targetDir;
        }

        downloadFilesContainer.innerHTML = '<div style="color: #64748b; font-style: italic; font-size: 0.82em; text-align: center; padding: 12px;"><i class="fas fa-spinner fa-spin"></i> Loading directory contents...</div>';

        try {
          const res = await fetch('/terminal/' + encodeURIComponent(nodeName) + '/list_files?dir=' + encodeURIComponent(targetDir), {
            credentials: 'same-origin'
          });
          const data = await res.json();
          if (!data.ok) {
            downloadFilesContainer.innerHTML = `<div style="color: #ef4444; font-size: 0.82em; padding: 8px;"><i class="fas fa-exclamation-triangle"></i> ${escapeHtml(data.error || 'Failed to list directory')}</div>`;
            return;
          }

          const resolvedDir = data.dir || targetDir;
          currentBrowsedDir = resolvedDir;
          if (downloadBrowseDir) downloadBrowseDir.textContent = resolvedDir;

          downloadFilesContainer.innerHTML = '';

          // If not at filesystem root '/', render parent directory '..' row
          if (resolvedDir !== '/' && resolvedDir !== '') {
            const parentDir = resolvedDir.replace(/\/[^\/]+\/?$/, '') || '/';
            const parentRow = document.createElement('div');
            parentRow.className = 'file-item-row';
            parentRow.innerHTML = `
              <div style="display: flex; align-items: center; gap: 8px; color: #94a3b8;">
                <i class="fas fa-level-up-alt" style="color: #94a3b8; font-size: 0.9em; width: 16px; text-align: center;"></i>
                <span style="font-family: monospace; font-weight: 500;">.. (parent directory)</span>
              </div>
            `;
            parentRow.addEventListener('click', () => {
              downloadPathInput.value = parentDir;
              inspectRemotePath(parentDir);
              fetchNodeFileList(parentDir);
            });
            downloadFilesContainer.appendChild(parentRow);
          }

          if (!data.items || data.items.length === 0) {
            const emptyDiv = document.createElement('div');
            emptyDiv.style.cssText = 'color: #64748b; font-style: italic; font-size: 0.82em; text-align: center; padding: 12px;';
            emptyDiv.textContent = 'Directory is empty';
            downloadFilesContainer.appendChild(emptyDiv);
            return;
          }

          data.items.forEach(item => {
            const row = document.createElement('div');
            row.className = 'file-item-row';

            let iconHtml = '<i class="fas fa-file-alt" style="color: #94a3b8; width: 16px; text-align: center;"></i>';
            if (item.type === 'dir') {
              iconHtml = '<i class="fas fa-folder" style="color: #f59e0b; width: 16px; text-align: center;"></i>';
            } else if (item.name.startsWith('id_') || item.name.endsWith('.pub') || item.name.endsWith('.pem') || item.name.endsWith('.key') || item.name === 'authorized_keys' || item.name === 'known_hosts' || item.name === 'config') {
              iconHtml = '<i class="fas fa-key" style="color: #eab308; width: 16px; text-align: center;"></i>';
            } else if (/\.(sh|bash|py|rb|pl|js|ts|yml|yaml|json|conf|cfg|ini)$/i.test(item.name)) {
              iconHtml = '<i class="fas fa-file-code" style="color: #38bdf8; width: 16px; text-align: center;"></i>';
            } else if (/\.(tar|gz|zip|bz2|xz|7z|tgz)$/i.test(item.name)) {
              iconHtml = '<i class="fas fa-file-archive" style="color: #ec4899; width: 16px; text-align: center;"></i>';
            }

            const leftDiv = document.createElement('div');
            leftDiv.style.cssText = 'display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0; overflow: hidden;';
            leftDiv.innerHTML = `
              ${iconHtml}
              <span style="font-family: monospace; color: #f8fafc; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${escapeHtml(item.name)}${item.type === 'dir' ? '/' : ''}</span>
            `;

            const rightDiv = document.createElement('div');
            rightDiv.style.cssText = 'display: flex; align-items: center; gap: 8px; margin-left: 8px;';

            if (item.type === 'file') {
              const sizeSpan = document.createElement('span');
              sizeSpan.style.cssText = 'color: #64748b; font-size: 0.85em; font-variant-numeric: tabular-nums;';
              sizeSpan.textContent = formatBytes(item.size);
              rightDiv.appendChild(sizeSpan);

              const dlBtn = document.createElement('button');
              dlBtn.className = 'quick-download-btn';
              dlBtn.innerHTML = '<i class="fas fa-download"></i>';
              dlBtn.title = `Download ${item.name}`;
              dlBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                downloadPathInput.value = item.path;
                inspectRemotePath(item.path);
                showToast(`Downloading ${item.name}...`, 'info');
                window.location.href = '/terminal/' + encodeURIComponent(nodeName) + '/download?path=' + encodeURIComponent(item.path);
              });
              rightDiv.appendChild(dlBtn);
            } else {
              const browseBtn = document.createElement('button');
              browseBtn.style.cssText = 'background: #334155; border: 1px solid #475569; color: #cbd5e1; padding: 1px 6px; border-radius: 3px; font-size: 0.78em; cursor: pointer;';
              browseBtn.textContent = 'Open';
              browseBtn.title = `Open directory ${item.name}`;
              browseBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                downloadPathInput.value = item.path;
                inspectRemotePath(item.path);
                fetchNodeFileList(item.path);
              });
              rightDiv.appendChild(browseBtn);
            }

            row.appendChild(leftDiv);
            row.appendChild(rightDiv);

            row.addEventListener('click', () => {
              downloadPathInput.value = item.path;
              inspectRemotePath(item.path);
              if (item.type === 'dir') {
                fetchNodeFileList(item.path);
              }
            });

            downloadFilesContainer.appendChild(row);
          });
        } catch (err) {
          downloadFilesContainer.innerHTML = `<div style="color: #ef4444; font-size: 0.82em; padding: 8px;"><i class="fas fa-exclamation-triangle"></i> ${escapeHtml(err.message || 'Error fetching files')}</div>`;
        }
      }

      if (downloadRefreshBtn) {
        downloadRefreshBtn.addEventListener('click', () => {
          fetchNodeFileList(currentBrowsedDir || (downloadPathInput && downloadPathInput.value) || '~');
        });
      }

      // Drag and drop onto terminal canvas
      window.addEventListener('dragenter', (e) => {
        if (e.dataTransfer && e.dataTransfer.types && Array.from(e.dataTransfer.types).includes('Files')) {
          e.preventDefault();
          dragCounter++;
          if (termDropOverlay) {
            termDropOverlay.style.display = 'flex';
            if (termDropDestHint) {
              const currentDir = (uploadDirInput && uploadDirInput.value.trim()) || nodeTargetInfo.default_dir || '~';
              termDropDestHint.textContent = `Destination: ${currentDir}`;
            }
          }
        }
      });

      window.addEventListener('dragover', (e) => {
        if (e.dataTransfer && e.dataTransfer.types && Array.from(e.dataTransfer.types).includes('Files')) {
          e.preventDefault();
        }
      });

      window.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dragCounter--;
        if (dragCounter <= 0) {
          dragCounter = 0;
          if (termDropOverlay) termDropOverlay.style.display = 'none';
        }
      });

      window.addEventListener('drop', async (e) => {
        e.preventDefault();
        dragCounter = 0;
        if (termDropOverlay) termDropOverlay.style.display = 'none';
        if (e.dataTransfer) {
          const { files, emptyDirs } = await getFilesFromDataTransfer(e.dataTransfer);
          if (files.length > 0 || emptyDirs.length > 0) {
            stageUploadItems(files, emptyDirs, false);
            openFilesModal('upload');
          }
        }
      });

      // Escape key closes modal
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (filesModalBackdrop && filesModalBackdrop.style.display === 'flex') {
            closeFilesModal();
          }
        }
      });

      // --- Load saved preferences from localStorage ---
      if (localStorage.getItem('ctlabs_max_len')) {
        maxLenSelect.value = localStorage.getItem('ctlabs_max_len');
      }
      if (localStorage.getItem('ctlabs_idle_timeout')) {
        localStorage.getItem('ctlabs_idle_timeout'); // fallback check
        const savedIdle = localStorage.getItem('ctlabs_idle_timeout');
        if (savedIdle !== null) idleTimeoutSelect.value = savedIdle;
      }

      // --- Save preferences on change ---
      maxLenSelect.addEventListener('change', () => {
        localStorage.setItem('ctlabs_max_len', maxLenSelect.value);
      });

      idleTimeoutSelect.addEventListener('change', () => {
        localStorage.setItem('ctlabs_idle_timeout', idleTimeoutSelect.value);
      });

      // Toggle settings popover menu
      settingsBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (openNodeMenu) openNodeMenu.style.display = 'none';
        const willOpen = settingsMenu.style.display !== 'block';
        settingsMenu.style.display = willOpen ? 'block' : 'none';
        if (willOpen && typeof window.loadTermSshAgentStatus === 'function') {
          window.loadTermSshAgentStatus();
        }
      });

      settingsClose.addEventListener('click', () => {
        settingsMenu.style.display = 'none';
      });

      document.addEventListener('click', (e) => {
        const sEl = document.getElementById('status');
        if (!settingsMenu.contains(e.target) && e.target !== settingsBtn && (!sEl || (e.target !== sEl && !sEl.contains(e.target)))) {
          settingsMenu.style.display = 'none';
        }
        if (openNodeMenu && !openNodeMenu.contains(e.target) && e.target !== openNodeBtn && !openNodeBtn.contains(e.target)) {
          openNodeMenu.style.display = 'none';
        }
      });

      // =======================================================================
      // Open / New Terminal Dropdown
      // =======================================================================
      const openNodeBtn = document.getElementById('open-node-btn');
      const openNodeMenu = document.getElementById('open-node-menu');
      const openNodeFilter = document.getElementById('open-node-filter');
      const openNodeList = document.getElementById('open-node-list');
      const openNodeCount = document.getElementById('open-node-count');

      let availableNodesCache = null;
      let isLoadingNodes = false;

      function launchNodeTerminal(targetNodeName) {
        if (typeof window.manageTerminal === 'function') {
          window.manageTerminal(targetNodeName);
        } else if (typeof window.openTerminal === 'function') {
          window.openTerminal(targetNodeName);
        } else {
          const w = 960, h = 660;
          const t = (window.top.outerHeight / 2) + window.top.screenY - (h / 2);
          const l = (window.top.outerWidth / 2) + window.top.screenX - (w / 2);
          const winName = `term_${targetNodeName.replace(/[^a-zA-Z0-9]/g, '_')}_${Date.now()}`;
          window.open(`/terminal/${encodeURIComponent(targetNodeName)}`, winName, `width=${w},height=${h},top=${t},left=${l},resizable=yes,scrollbars=yes,popup=yes,menubar=no,toolbar=no,location=no,status=no`);
        }
      }

      function renderNodeList(nodes, filterText = '') {
        if (!openNodeList) return;
        const query = (filterText || '').trim().toLowerCase();
        const filtered = (nodes || []).filter(n => {
          if (!query) return true;
          return (n.name && n.name.toLowerCase().includes(query)) ||
                 (n.type && n.type.toLowerCase().includes(query)) ||
                 (n.group && n.group.toLowerCase().includes(query));
        });

        if (openNodeCount) openNodeCount.textContent = filtered.length;

        if (filtered.length === 0) {
          openNodeList.innerHTML = `<div style="text-align: center; color: #64748b; padding: 12px; font-size: 0.85em;">${query ? 'No matching nodes found' : 'No nodes available'}</div>`;
          return;
        }

        // Sort: running nodes first, then alphabetical by name
        filtered.sort((a, b) => {
          if (a.running !== b.running) return a.running ? -1 : 1;
          return a.name.localeCompare(b.name);
        });

        openNodeList.innerHTML = '';
        filtered.forEach(n => {
          const isCurrent = (n.name === nodeName);
          const item = document.createElement('div');
          item.className = 'open-node-item' + (isCurrent ? ' current' : '');
          item.title = isCurrent ? `${n.name} (current session)` : `Open terminal for ${n.name} (${n.running ? 'running' : 'stopped'})`;

          const left = document.createElement('div');
          left.style.display = 'flex';
          left.style.alignItems = 'center';
          left.style.gap = '8px';
          left.style.minWidth = '0';

          const dot = document.createElement('span');
          dot.className = 'open-node-dot ' + (n.running ? 'running' : 'stopped');
          dot.title = n.running ? 'Running' : 'Stopped';

          const icon = document.createElement('i');
          icon.className = `fas ${n.icon || 'fa-server'}`;
          icon.style.color = isCurrent ? '#38bdf8' : (n.running ? '#94a3b8' : '#64748b');
          icon.style.fontSize = '0.9em';
          icon.style.width = '14px';
          icon.style.textAlign = 'center';

          const nameSpan = document.createElement('span');
          nameSpan.textContent = n.name;
          nameSpan.style.fontWeight = isCurrent ? '700' : '500';
          nameSpan.style.color = isCurrent ? '#38bdf8' : (n.running ? '#f8fafc' : '#94a3b8');
          nameSpan.style.overflow = 'hidden';
          nameSpan.style.textOverflow = 'ellipsis';
          nameSpan.style.whiteSpace = 'nowrap';

          left.appendChild(dot);
          left.appendChild(icon);
          left.appendChild(nameSpan);

          if (isCurrent) {
            const curTag = document.createElement('span');
            curTag.textContent = '(current)';
            curTag.style.fontSize = '0.75em';
            curTag.style.color = '#38bdf8';
            curTag.style.opacity = '0.85';
            curTag.style.fontStyle = 'italic';
            left.appendChild(curTag);
          }

          const right = document.createElement('div');
          right.style.display = 'flex';
          right.style.alignItems = 'center';
          right.style.gap = '5px';

          const badge = document.createElement('span');
          badge.className = `open-node-badge ${n.type || 'host'}`;
          badge.textContent = n.type || 'node';
          right.appendChild(badge);

          item.appendChild(left);
          item.appendChild(right);

          item.addEventListener('click', (e) => {
            e.stopPropagation();
            if (openNodeMenu) openNodeMenu.style.display = 'none';
            launchNodeTerminal(n.name);
          });

          openNodeList.appendChild(item);
        });
      }

      async function fetchAvailableNodes(force = false) {
        if (availableNodesCache && !force) {
          renderNodeList(availableNodesCache, openNodeFilter ? openNodeFilter.value : '');
          return;
        }
        if (isLoadingNodes) return;
        isLoadingNodes = true;
        if (openNodeList && !availableNodesCache) {
          openNodeList.innerHTML = '<div style="text-align: center; color: #64748b; padding: 12px; font-size: 0.85em;"><i class="fas fa-spinner fa-spin"></i> Loading nodes...</div>';
        }
        try {
          const res = await fetch(`/terminal/${encodeURIComponent(nodeName)}/available_nodes?_=${Date.now()}`);
          if (!res.ok) throw new Error('Failed to fetch available nodes');
          const data = await res.json();
          availableNodesCache = data.nodes || [];
          renderNodeList(availableNodesCache, openNodeFilter ? openNodeFilter.value : '');
        } catch (err) {
          console.error('[OpenNodeMenu]', err);
          if (openNodeList) {
            openNodeList.innerHTML = '<div style="text-align: center; color: #ef4444; padding: 12px; font-size: 0.85em;">Failed to load nodes</div>';
          }
        } finally {
          isLoadingNodes = false;
        }
      }

      if (openNodeBtn && openNodeMenu) {
        openNodeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = openNodeMenu.style.display === 'block';
          if (isOpen) {
            openNodeMenu.style.display = 'none';
          } else {
            if (settingsMenu) settingsMenu.style.display = 'none';
            openNodeMenu.style.display = 'block';
            if (openNodeFilter) {
              openNodeFilter.value = '';
              setTimeout(() => openNodeFilter.focus(), 50);
            }
            fetchAvailableNodes();
          }
        });

        if (openNodeFilter) {
          openNodeFilter.addEventListener('input', () => {
            renderNodeList(availableNodesCache || [], openNodeFilter.value);
          });
          openNodeFilter.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              openNodeMenu.style.display = 'none';
            } else if (e.key === 'Enter') {
              const firstItem = openNodeList.querySelector('.open-node-item');
              if (firstItem) firstItem.click();
            }
          });
        }
      }

      // --- Modular Settings Sections & Tabs ---
      function switchSettingsTab(section) {
        document.querySelectorAll('.settings-tab-btn').forEach(btn => {
          if (btn.dataset.section === section) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        const sections = document.querySelectorAll('.settings-section');
        sections.forEach(sec => {
          if (section === 'all') {
            sec.style.display = 'block';
            sec.classList.remove('no-divider');
          } else {
            const match = sec.id === `settings-sec-${section}`;
            sec.style.display = match ? 'block' : 'none';
            if (match) sec.classList.add('no-divider');
          }
        });
        localStorage.setItem('ctlabs_term_settings_tab', section);
      }

      document.querySelectorAll('.settings-tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          switchSettingsTab(btn.dataset.section);
        });
      });

      const initialSettingsTab = localStorage.getItem('ctlabs_term_settings_tab') || 'all';
      switchSettingsTab(initialSettingsTab);

      // --- Terminal Display Preferences ---
      const fontSizeSelect = document.getElementById('font-size-select');
      const cursorStyleSelect = document.getElementById('cursor-style-select');
      const cursorBlinkSelect = document.getElementById('cursor-blink-select');
      const mouseModeSelect = document.getElementById('mouse-mode-select');

      const savedFontSize = parseInt(localStorage.getItem('ctlabs_term_font_size'), 10) || 14;
      const savedCursorStyle = localStorage.getItem('ctlabs_term_cursor_style') || 'block';
      const savedCursorBlink = localStorage.getItem('ctlabs_term_cursor_blink') !== 'false';
      let mouseReportingMode = localStorage.getItem('ctlabs_term_mouse_mode') || 'select';

      if (fontSizeSelect) fontSizeSelect.value = String(savedFontSize);
      if (cursorStyleSelect) cursorStyleSelect.value = savedCursorStyle;
      if (cursorBlinkSelect) cursorBlinkSelect.value = String(savedCursorBlink);
      if (mouseModeSelect) mouseModeSelect.value = mouseReportingMode;

      if (mouseModeSelect) {
        mouseModeSelect.addEventListener('change', () => {
          mouseReportingMode = mouseModeSelect.value;
          localStorage.setItem('ctlabs_term_mouse_mode', mouseReportingMode);
        });
      }

      const initialCols = 130;
      const initialRows = 40;

      const term = new Terminal({
        cols: initialCols,
        rows: initialRows,
        lineHeight: 1,
        theme: { background: '#300a24', foreground: '#ffffff', cursor: '#ffffff', selectionBackground: 'rgba(56, 189, 248, 0.3)' },
        fontFamily: '"Courier New", Courier, monospace',
        cursorBlink: savedCursorBlink,
        cursorStyle: savedCursorStyle,
        fontSize: savedFontSize,
        macOptionClickForcesSelection: true,
        macOptionIsMeta: false
      });

      const execCopy = (text) => {
        if (!text) return false;
        try {
          if (term && term.textarea) {
            term.textarea.value = text;
            term.textarea.focus({ preventScroll: true });
            term.textarea.select();
            if (term.textarea.setSelectionRange) {
              term.textarea.setSelectionRange(0, text.length);
            }
            if (document.execCommand('copy')) {
              return true;
            }
          }
        } catch (e) {}

        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '0';
          ta.style.left = '0';
          ta.style.width = '2em';
          ta.style.height = '2em';
          ta.style.padding = '0';
          ta.style.border = 'none';
          ta.style.outline = 'none';
          ta.style.boxShadow = 'none';
          ta.style.background = 'transparent';
          ta.style.opacity = '0.01';
          ta.style.zIndex = '-9999';
          document.body.appendChild(ta);
          ta.focus({ preventScroll: true });
          ta.select();
          if (ta.setSelectionRange) {
            ta.setSelectionRange(0, text.length);
          }
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          return ok;
        } catch (e) {
          return false;
        }
      };

      let lastCopyToastTime = 0;
      const copyTerminalSelection = (showFeedback = true) => {
        const selection = term ? term.getSelection() : '';
        if (!selection || !selection.length) return false;

        let copied = false;
        try {
          copied = execCopy(selection);
        } catch (err) {
          copied = false;
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(selection).then(() => {
            const now = Date.now();
            if (showFeedback && !copied && (now - lastCopyToastTime > 1200)) {
              lastCopyToastTime = now;
              showToast('Copied to clipboard', 'success', 2000);
            }
          }).catch(() => {});
        }

        const now = Date.now();
        if (copied && showFeedback && (now - lastCopyToastTime > 1200)) {
          lastCopyToastTime = now;
          showToast('Copied to clipboard', 'success', 2000);
        }
        return copied;
      };

      const fitAddon = new FitAddon.FitAddon();
      term.loadAddon(fitAddon);

      const serializeAddon = new SerializeAddon.SerializeAddon();
      term.loadAddon(serializeAddon);

      if (typeof Unicode11Addon !== 'undefined' && Unicode11Addon.Unicode11Addon) {
        try {
          const unicode11Addon = new Unicode11Addon.Unicode11Addon();
          term.loadAddon(unicode11Addon);
          term.unicode.activeVersion = '11';
        } catch (e) {
          console.warn('Failed to activate Unicode 11 addon in xterm:', e);
        }
      }

      term.open(container);

      // Force native text selection even when TUI apps (antigravity_cli, claude code, opencode, etc.)
      // enable mouse reporting mode via DECSET 1000/1002/1003.
      if (term._core && term._core._selectionService) {
        const origShouldForce = term._core._selectionService.shouldForceSelection.bind(term._core._selectionService);
        term._core._selectionService.shouldForceSelection = function(e) {
          if (mouseReportingMode === 'select') {
            // In selection mode, any left-click drag forces native text selection
            if (e.button === 0) {
              return true;
            }
            return origShouldForce(e);
          }
          return origShouldForce(e);
        };
      }

      // Synchronize selection changes directly into term.textarea so macOS Edit->Copy,
      // native browser copy commands, and auto-copy work reliably on WebKit/Safari and Chrome.
      term.onSelectionChange(() => {
        const selection = term.getSelection();
        if (selection && selection.length > 0) {
          if (term.textarea) {
            try {
              term.textarea.value = selection;
              term.textarea.focus({ preventScroll: true });
              term.textarea.select();
              if (term.textarea.setSelectionRange) {
                term.textarea.setSelectionRange(0, selection.length);
              }
            } catch (err) {}
          }
          copyTerminalSelection(true);
        } else {
          if (term.textarea) {
            try {
              term.textarea.value = '';
            } catch (err) {}
          }
        }
      });

      // Auto-copy selection on mouseup anywhere in the document
      document.addEventListener('mouseup', (e) => {
        if (e.button === 0 && term && term.hasSelection()) {
          copyTerminalSelection(true);
        }
      });

      // Right-click on selected text copies it immediately
      container.addEventListener('contextmenu', (e) => {
        if (term && term.hasSelection()) {
          e.preventDefault();
          copyTerminalSelection(true);
        }
      });

      // Native browser copy event hook (browser Edit > Copy, system shortcuts)
      document.addEventListener('copy', (e) => {
        const text = (term && term.hasSelection()) ? term.getSelection() : (term && term.textarea ? term.textarea.value : '');
        if (text && text.length > 0) {
          if (e.clipboardData) {
            e.clipboardData.setData('text/plain', text);
            e.preventDefault();
            const now = Date.now();
            if (typeof showToast === 'function' && (now - lastCopyToastTime > 1200)) {
              lastCopyToastTime = now;
              showToast('Copied to clipboard', 'success', 2000);
            }
          }
        }
      });

      // Apply dynamic terminal display options
      const reloadProtectSelect = document.getElementById('reload-protect-select');
      let reloadProtection = localStorage.getItem('ctlabs_term_reload_protect') !== 'false';
      if (reloadProtectSelect) reloadProtectSelect.value = String(reloadProtection);

      if (reloadProtectSelect) {
        reloadProtectSelect.addEventListener('change', () => {
          reloadProtection = reloadProtectSelect.value === 'true';
          localStorage.setItem('ctlabs_term_reload_protect', reloadProtection);
        });
      }

      if (fontSizeSelect) {
        fontSizeSelect.addEventListener('change', () => {
          const sz = parseInt(fontSizeSelect.value, 10);
          term.options.fontSize = sz;
          fitAddon.fit();
          localStorage.setItem('ctlabs_term_font_size', sz);
        });
      }

      if (cursorStyleSelect) {
        cursorStyleSelect.addEventListener('change', () => {
          term.options.cursorStyle = cursorStyleSelect.value;
          localStorage.setItem('ctlabs_term_cursor_style', cursorStyleSelect.value);
        });
      }

      if (cursorBlinkSelect) {
        cursorBlinkSelect.addEventListener('change', () => {
          const blink = cursorBlinkSelect.value === 'true';
          term.options.cursorBlink = blink;
          localStorage.setItem('ctlabs_term_cursor_blink', blink);
        });
      }

      const cellSize = () => {
        const d = term._core && term._core._renderService && term._core._renderService.dimensions;
        if (d && d.css && d.css.cell) return d.css.cell;
        if (d && d.actualCellHeight) return { width: d.actualCellWidth, height: d.actualCellHeight };
        return null;
      };

      const chromeW = window.outerWidth - window.innerWidth;
      const chromeH = window.outerHeight - window.innerHeight;
      const scrollBarWidth = term._core && term._core.viewport ? term._core.viewport.scrollBarWidth : 0;

      const pinToGrid = () => {
        const cell = cellSize();
        if (!cell || !window.resizeTo) return;
        fitAddon.fit();
        window.resizeTo(
          Math.round(initialCols * cell.width + scrollBarWidth) + chromeW,
          Math.round(initialRows * cell.height + headerEl.offsetHeight) + chromeH
        );
        fitAddon.fit();
      };

      // Client-side recording state (asciicast v2)
      let recording = false;
      let recStartTime = 0;
      let recLines = [];
      let recCols = term.cols;
      let recRows = term.rows;
      let timerInterval = null;
      let idleTimeout = null;
      let maxRecordingTimeout = null;

      function recNow() {
        return (performance.now() - recStartTime) / 1000.0;
      }

      function formatTime(seconds) {
        const m = Math.floor(seconds / 60).toString().padStart(2, '0');
        const s = Math.floor(seconds % 60).toString().padStart(2, '0');
        return `${m}:${s}`;
      }

      const stopRecording = () => {
        if (!recording) return;
        recording = false;

        if (timerInterval) clearInterval(timerInterval);
        if (idleTimeout) clearTimeout(idleTimeout);
        if (maxRecordingTimeout) clearTimeout(maxRecordingTimeout);

        recBtn.style.borderColor = '#475569';
        recBtn.style.backgroundColor = 'transparent';
        recLabel.textContent = 'REC';
        recBtn.firstElementChild.className = 'fas fa-circle';
        if (recTimer) recTimer.style.display = 'none';

        const tabRecDot = document.getElementById('settings-tab-rec-dot');
        if (tabRecDot) tabRecDot.style.display = 'none';

        const cast = recLines.join('\n') + '\n';
        const blob = new Blob([cast], { type: 'application/x-asciicast' });
        const form = new FormData();
        const fname = 'term_' + nodeName.replace(/[^a-zA-Z0-9]/g, '_') + '_' + Date.now() + '.cast';
        form.append('file', blob, fname);
        form.append('node', nodeName);
        try {
          const activeWalkthrough = localStorage.getItem('ctlabs_active_walkthrough');
          if (activeWalkthrough) {
            form.append('walkthrough', activeWalkthrough);
          }
        } catch (e) {}
        fetch('/recordings/upload', { method: 'POST', body: form, credentials: 'same-origin' })
          .catch(() => {});
      };

      const resetIdleTimer = () => {
        if (!recording) return;
        const idleSecs = parseInt(idleTimeoutSelect.value, 10);
        if (idleSecs <= 0) return; // Disabled

        if (idleTimeout) clearTimeout(idleTimeout);
        idleTimeout = setTimeout(() => {
          stopRecording();
        }, idleSecs * 1000);
      };

      if (recBtn) {
        recBtn.addEventListener('click', () => {
          if (recBtn.disabled) return;
          if (!recording) {
            recStartTime = performance.now();
            recCols = term.cols;
            recRows = term.rows;
            recLines = [];
            recLines.push(JSON.stringify({
              version: 2,
              width: recCols,
              height: recRows,
              timestamp: Math.floor(Date.now() / 1000),
              title: nodeName + ' - ' + new Date().toISOString(),
              env: { TERM: 'xterm-256color', SHELL: '/bin/bash' },
              ctlabs: { node: nodeName, recorder: 'ctlabs' },
              theme: {
                fg: '#ffffff',
                bg: '#300a24',
                palette: '#2e3436:#cc0000:#4e9a06:#c4a000:#3465a4:#75507b:#06989a:#d3d3d3:#555753:#ef2929:#8ae234:#fce94f:#729fcf:#ad7fa8:#34e2e2:#eeeeec'
              }
            }));

            const screenSnapshot = serializeAddon.serialize();
            if (screenSnapshot) {
              recLines.push(JSON.stringify([recNow(), 'o', screenSnapshot]));
            }

            recording = true;
            const tabRecDot = document.getElementById('settings-tab-rec-dot');
            if (tabRecDot) tabRecDot.style.display = 'inline-block';
            recBtn.style.borderColor = '#ef4444';
            recBtn.style.backgroundColor = 'rgba(239, 68, 68, 0.18)';
            recLabel.textContent = 'STOP';
            recBtn.firstElementChild.className = 'fas fa-square';
            if (recTimer) {
              recTimer.textContent = '00:00';
              recTimer.style.display = 'inline';
            }

            timerInterval = setInterval(() => {
              const elapsed = (performance.now() - recStartTime) / 1000.0;
              if (recTimer) recTimer.textContent = formatTime(elapsed);
            }, 1000);

            // Max length timeout check
            const maxSecs = parseInt(maxLenSelect.value, 10);
            if (maxSecs > 0) {
              maxRecordingTimeout = setTimeout(() => {
                stopRecording();
              }, maxSecs * 1000);
            }

            resetIdleTimer();
          } else {
            stopRecording();
          }

          // Return keyboard focus to the terminal after toggling recording.
          term.focus();
        });
      }

      const origWrite = term.write.bind(term);
      term.write = function(data) {
        if (recording) {
          resetIdleTimer();
          if (typeof data === 'string') {
            recLines.push(JSON.stringify([recNow(), 'o', data]));
          } else if (data instanceof Uint8Array) {
            try {
              const s = new TextDecoder().decode(data);
              recLines.push(JSON.stringify([recNow(), 'o', s]));
            } catch(e) {}
          }
        }
        return origWrite(data);
      };

      term.attachCustomKeyEventHandler((e) => {
        // macOS Command+C:
        // When text is selected, copy it. Do NOT call e.preventDefault(), allowing browser native copy event to fire.
        if (e.metaKey && !e.ctrlKey && e.key.toLowerCase() === 'c') {
          if (term.hasSelection()) {
            if (e.type === 'keydown') {
              copyTerminalSelection(true);
            }
            return false; // Tells xterm not to handle it as terminal typing
          }
          return false; // No selection: Cmd+C is browser no-op, never send to terminal
        }

        // Ctrl+C (Linux/Windows copy when selected, or Mac user using Ctrl+C):
        // If text is selected, COPY and NEVER send \x03 (SIGINT) to the app!
        if (e.ctrlKey && !e.metaKey && e.key.toLowerCase() === 'c') {
          if (!e.shiftKey && term.hasSelection()) {
            if (e.type === 'keydown') {
              copyTerminalSelection(true);
            }
            e.preventDefault();
            return false;
          }
          // When nothing is selected, allow Ctrl+C to send SIGINT (\x03)
          return true;
        }

        // Ctrl+Shift+C = copy selection (standard terminal shortcut). Never sent to the app.
        if (e.ctrlKey && e.shiftKey && !e.metaKey && e.key.toLowerCase() === 'c') {
          if (e.type === 'keydown') {
            e.preventDefault();
            copyTerminalSelection(true);
          }
          return false;
        }

        // Prevent accidental browser reload shortcuts (F5, Cmd+R on macOS)
        // Ctrl+R is bash/readline reverse-i-search and MUST be passed through to xterm
        if (e.key === 'F5' || (e.metaKey && e.key.toLowerCase() === 'r')) {
          if (e.type === 'keydown') {
            e.preventDefault();
          }
          return false;
        }

        // Allow Ctrl+R to reach bash for reverse-i-search while preventing browser reload
        if (e.ctrlKey && !e.metaKey && e.key.toLowerCase() === 'r') {
          if (e.type === 'keydown') {
            e.preventDefault();
          }
          return true;
        }

        // Intercept Shift+Enter to send ESC + CR (\x1b\r) instead of plain \r
        // This is the standard sequence for multiline prompts in Claude Code, IPython, etc.
        if (e.key === 'Enter' && e.shiftKey) {
          if (e.type === 'keydown') {
            e.preventDefault();
            if (recording) resetIdleTimer();
            if (activeWs && activeWs.readyState === WebSocket.OPEN) {
              activeWs.send(JSON.stringify({ type: 'input', data: '\x1b\r' }));
            }
          }
          return false;
        }
        return true;
      });

      term.onData(data => {
        if (recording) resetIdleTimer();
        if (activeWs && activeWs.readyState === WebSocket.OPEN) {
          activeWs.send(JSON.stringify({ type: 'input', data: data }));
        }
      });

      term.onResize(size => {
        if (recording) {
          recLines.push(JSON.stringify([recNow(), 'r', size.cols + 'x' + size.rows]));
          recCols = size.cols;
          recRows = size.rows;
          resetIdleTimer();
        }
        if (activeWs && activeWs.readyState === WebSocket.OPEN) {
          activeWs.send(JSON.stringify({ type: 'resize', cols: size.cols, rows: size.rows }));
        }
      });

      window.addEventListener('resize', () => fitAddon.fit());

      const connectBtn = document.getElementById('connect-btn');
      const statusEl = document.getElementById('status');
      let intentionalDisconnect = false;
      let currentSessionCount = 1;

      // Settings Sessions Management
      const cleanAllBtn = document.getElementById('btn-clean-all-sessions');
      const settingsSessionsCount = document.getElementById('settings-sessions-count');
      const settingsTabSessionsBadge = document.getElementById('settings-tab-sessions-badge');

      const setDisconnectedState = () => {
        if (connectBtn) {
          connectBtn.className = 'term-conn-btn disconnected';
          connectBtn.innerHTML = '<i class="fas fa-plug"></i>';
          connectBtn.title = 'Connect';
          connectBtn.disabled = false;
        }
        if (statusEl) {
          statusEl.className = 'status disconnected';
          statusEl.textContent = currentSessionCount;
          statusEl.title = `Disconnected · ${currentSessionCount}/3 active sessions (click to connect)`;
        }
      };

      const setConnectedState = () => {
        if (connectBtn) {
          connectBtn.className = 'term-conn-btn connected';
          connectBtn.innerHTML = '<i class="fas fa-plug-circle-xmark"></i>';
          connectBtn.title = 'Disconnect';
          connectBtn.disabled = false;
        }
        if (statusEl) {
          statusEl.className = 'status connected';
          statusEl.textContent = currentSessionCount;
          statusEl.title = `Connected · ${currentSessionCount}/3 active sessions (click Settings to manage)`;
        }
      };

      const setConnectingState = () => {
        if (connectBtn) {
          connectBtn.className = 'term-conn-btn connecting';
          connectBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
          connectBtn.title = 'Connecting...';
          connectBtn.disabled = true;
        }
        if (statusEl) {
          statusEl.className = 'status connecting';
          statusEl.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
          statusEl.title = 'Connecting...';
        }
      };

      const updateSessionCount = async () => {
        try {
          const res = await fetch(`/terminal/${encodeURIComponent(nodeName)}/sessions?_=${Date.now()}`);
          if (!res.ok) return;
          const data = await res.json();
          const count = typeof data.count === 'number' ? data.count : 0;
          currentSessionCount = count;

          if (settingsSessionsCount) {
            settingsSessionsCount.textContent = `${count} of 3`;
            settingsSessionsCount.style.color = count >= 3 ? '#ef4444' : '#38bdf8';
          }
          if (settingsTabSessionsBadge) {
            settingsTabSessionsBadge.textContent = count;
            settingsTabSessionsBadge.style.display = 'inline-block';
            settingsTabSessionsBadge.style.background = count >= 3 ? '#ef4444' : '#0284c7';
          }

          if (statusEl) {
            if (statusEl.classList.contains('connected')) {
              statusEl.textContent = count;
              statusEl.title = `Connected · ${count}/3 active sessions (click Settings to manage)`;
            } else if (statusEl.classList.contains('disconnected')) {
              statusEl.textContent = count;
              statusEl.title = `Disconnected · ${count}/3 active sessions (click to connect)`;
            }
          }
        } catch (e) {}
      };

      if (cleanAllBtn) {
        cleanAllBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          cleanAllBtn.disabled = true;
          const origHtml = cleanAllBtn.innerHTML;
          cleanAllBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Cleaning...</span>';
          try {
            const res = await fetch(`/terminal/${encodeURIComponent(nodeName)}/terminate_all`, { method: 'POST' });
            if (!res.ok) throw new Error('Server returned error');
            sessionStorage.removeItem(sessionKey);
            if (activeWs && (activeWs.readyState === WebSocket.OPEN || activeWs.readyState === WebSocket.CONNECTING)) {
              intentionalDisconnect = true;
              try { activeWs.close(); } catch (e) {}
            }
            currentSessionCount = 0;
            setDisconnectedState();
            term.write('\r\n\x1b[33m[All sessions for this node were terminated by user]\x1b[0m\r\n');
            await updateSessionCount();
          } catch (err) {
            alert('Failed to clean sessions: ' + err.message);
          } finally {
            cleanAllBtn.disabled = false;
            cleanAllBtn.innerHTML = origHtml;
          }
        });
      }

      if (!window.name) {
        window.name = 'term_' + encodeURIComponent(nodeName) + '_' + Math.random().toString(36).substring(2, 10);
      }
      const sessionKey = 'ctlabs_term_session_' + encodeURIComponent(nodeName) + '_' + window.name;

      const getOrCreateSessionId = () => {
        let sid = sessionStorage.getItem(sessionKey);
        if (!sid) {
          sid = (typeof crypto !== 'undefined' && crypto.randomUUID) ?
            crypto.randomUUID() :
            ('sess_' + Math.random().toString(36).substring(2, 15) + Date.now().toString(36));
          sessionStorage.setItem(sessionKey, sid);
        }
        return sid;
      };

      const openSocket = (token = null) => {
        const sid = getOrCreateSessionId();
        const protocol = window.location.protocol === 'https:' ? 'wss://' : 'ws://';
        let wsUrl = protocol + window.location.host + '/terminal/' + encodeURIComponent(nodeName) +
                    `?cols=${term.cols}&rows=${term.rows}&session_id=${encodeURIComponent(sid)}`;
        if (token) {
          wsUrl += `&token=${encodeURIComponent(token)}`;
        }
        const ws = new WebSocket(wsUrl);
        activeWs = ws;

        ws.onopen = () => {
          setConnectedState();
          term.focus();
          ws.send(JSON.stringify({ type: 'resize', cols: term.cols, rows: term.rows }));
          updateSessionCount();
          if (token && configuredFiles.length > 0) {
            const names = configuredFiles.map(f => f.env_var).join(', ');
            term.write(`\r\n\x1b[32m[✓ Controller environment files active: ${names}]\x1b[0m\r\n`);
          }
          if (recBtn) {
            recBtn.disabled = false;
            recBtn.style.opacity = '1';
            recBtn.style.cursor = 'pointer';
          }
        };

        ws.onmessage = (event) => {
          if (typeof event.data === 'string') {
            if (event.data.startsWith('\x00')) {
              // Ignore control frame in terminal display
              return;
            }
            if (event.data.includes('[Session closed by container]') || event.data.includes('[Session Limit Reached')) {
              sessionStorage.removeItem(sessionKey);
              updateSessionCount();
            }
          }
          term.write(event.data);
        };

        ws.onclose = () => {
          if (intentionalReconnect) return;
          setDisconnectedState();
          updateSessionCount();
          if (intentionalDisconnect) {
            intentionalDisconnect = false;
            term.write('\r\n\x1b[33m[Disconnected by user — Session terminated]\x1b[0m\r\n');
          } else {
            term.write('\r\n\x1b[31m[Connection closed]\x1b[0m\r\n');
          }

          if (recording) {
            stopRecording();
          }
          if (recBtn) {
            recBtn.disabled = true;
            recBtn.style.opacity = '0.5';
            recBtn.style.cursor = 'not-allowed';
            recBtn.style.borderColor = '#475569';
            recBtn.style.backgroundColor = 'transparent';
          }
        };

        ws.onerror = () => {
          if (intentionalReconnect) return;
          setDisconnectedState();
        };
      };

      const disconnectTerminal = () => {
        const sid = sessionStorage.getItem(sessionKey);
        sessionStorage.removeItem(sessionKey);
        intentionalDisconnect = true;

        if (activeWs && (activeWs.readyState === WebSocket.OPEN || activeWs.readyState === WebSocket.CONNECTING)) {
          if (activeWs.readyState === WebSocket.OPEN) {
            try {
              activeWs.send(JSON.stringify({ type: 'terminate' }));
            } catch (e) {}
          }
          activeWs.close();
        } else {
          setDisconnectedState();
        }

        if (sid) {
          fetch(`/terminal/${encodeURIComponent(nodeName)}/terminate_session`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ session_id: sid })
          }).then(() => updateSessionCount()).catch(() => {});
        } else {
          updateSessionCount();
        }
      };

      const connectTerminal = async () => {
        intentionalDisconnect = false;
        setConnectingState();
        try {
          if (activeWs && (activeWs.readyState === WebSocket.OPEN || activeWs.readyState === WebSocket.CONNECTING)) {
            intentionalReconnect = true;
            activeWs.close();
            intentionalReconnect = false;
          }
          let token = null;
          if (isController && configuredFiles.length > 0) {
            try {
              token = await stageEnvFiles(configuredFiles);
            } catch (err) {
              term.write(`\r\n\x1b[31m[Failed to stage saved environment files: ${err.message}]\x1b[0m\r\n`);
            }
          }
          openSocket(token);
        } catch (err) {
          setDisconnectedState();
        }
      };

      const toggleConnection = () => {
        if (activeWs && (activeWs.readyState === WebSocket.OPEN || activeWs.readyState === WebSocket.CONNECTING)) {
          disconnectTerminal();
        } else {
          connectTerminal();
        }
      };

      if (connectBtn) {
        connectBtn.addEventListener('click', toggleConnection);
      }
      if (statusEl) {
        statusEl.addEventListener('click', (e) => {
          e.stopPropagation();
          if (statusEl.classList.contains('disconnected')) {
            connectTerminal();
          } else if (statusEl.classList.contains('connected')) {
            if (openNodeMenu) openNodeMenu.style.display = 'none';
            const willOpen = settingsMenu.style.display !== 'block';
            settingsMenu.style.display = willOpen ? 'block' : 'none';
            if (willOpen) {
              switchSettingsTab('terminal');
              if (typeof window.loadTermSshAgentStatus === 'function') {
                window.loadTermSshAgentStatus();
              }
            }
          }
        });
      }

      // Guard against accidental reloads (typing in address bar and pressing Enter, F5, Ctrl+R, or closing)
      window.addEventListener('beforeunload', (e) => {
        if (reloadProtection && activeWs && activeWs.readyState === WebSocket.OPEN) {
          e.preventDefault();
          e.returnValue = '';
          return '';
        }
      });

      // Terminate session immediately when window/tab is closed
      window.addEventListener('pagehide', () => {
        const sid = sessionStorage.getItem(sessionKey);
        if (sid) {
          sessionStorage.removeItem(sessionKey);
          if (activeWs && activeWs.readyState === WebSocket.OPEN) {
            try { activeWs.send(JSON.stringify({ type: 'terminate' })); } catch (e) {}
          }
          const payload = JSON.stringify({ session_id: sid });
          if (navigator.sendBeacon) {
            const blob = new Blob([payload], { type: 'application/json' });
            navigator.sendBeacon(`/terminal/${encodeURIComponent(nodeName)}/terminate_session`, blob);
          } else {
            fetch(`/terminal/${encodeURIComponent(nodeName)}/terminate_session`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: payload,
              keepalive: true
            }).catch(() => {});
          }
        }
      });

      // Prevent accidental reload shortcuts when window has focus outside terminal
      window.addEventListener('keydown', (e) => {
        if (e.key === 'F5' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'r')) {
          e.preventDefault();
        }
      });

      const start = () => {
        pinToGrid();
        requestAnimationFrame(() => {
          fitAddon.fit();
          connectTerminal();
          updateSessionCount();
          setInterval(updateSessionCount, 8000);
        });
      };

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(start).catch(() => start());
      } else {
        start();
      }
    });
  </script>
</body>
</html>
